{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(timeout:*)",
      "Bash(tasklist:*)",
      "Bash(findstr:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet run:*)",
      "Bash(git add:*)",
      "Bash(taskkill //F //IM GrainOriginatorPortal.Api.exe)",
      "Bash(cmd /c \"taskkill /F /IM GrainOriginatorPortal.Api.exe\")"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pfx)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
