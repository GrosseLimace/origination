{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "paths": {
      "@core/*": ["./src/app/core/*"],
      "@shared/*": ["./src/app/shared/*"],
      "@features/bid-sheet": ["./src/app/features/bid-sheet/index.ts"],
      "@features/calculators": ["./src/app/features/calculators/index.ts"],
      "@features/customers": ["./src/app/features/customers/index.ts"],
      "@features/engagement": ["./src/app/features/engagement/index.ts"],
      "@features/help": ["./src/app/features/help/index.ts"],
      "@features/lists": ["./src/app/features/lists/index.ts"],
      "@features/producers": ["./src/app/features/producers/index.ts"],
      "@features/usage-analytics": ["./src/app/features/usage-analytics/index.ts"],
      "@features/whats-new": ["./src/app/features/whats-new/index.ts"],
      "@models": ["./src/app/models/index.ts"],
      "@models/*": ["./src/app/models/*"],
      "@env/*": ["./src/environments/*"],
      "@testing/*": ["./src/testing/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
