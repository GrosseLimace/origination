<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GrainOriginatorPortal.Api.Tests" />
  </ItemGroup>

  <!--
    The What's New release notes are embedded in the assembly rather than served from wwwroot.
    UseStaticFiles runs before UseAuthentication, so anything under wwwroot is reachable without
    a token; the notes describe internal work and are streamed by WhatsNewController behind
    [Authorize] instead. The Remove is required because the Web SDK globs **\*.json as Content
    by default, which would publish a second, public copy alongside the embedded one.
    The self-help content (HelpController) follows the same rule for the same reason.
  -->
  <ItemGroup>
    <Content Remove="Content\whats-new.json" />
    <EmbeddedResource Include="Content\whats-new.json" />
    <Content Remove="Content\help-faq.json" />
    <EmbeddedResource Include="Content\help-faq.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.0" />
    <PackageReference Include="Azure.Identity" Version="1.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.1" />
    <!-- Pin transitive Microsoft.OpenApi to a patched version. Microsoft.AspNetCore.OpenApi 10.0.1
         pulls Microsoft.OpenApi 2.0.0, which has a High-severity advisory (GHSA-v5pm-xwqc-g5wc);
         fixed in 2.7.5. Remove this pin once the parent package floors Microsoft.OpenApi >= 2.7.5. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.3.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="3.8.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GrainOriginatorPortal.Infrastructure\GrainOriginatorPortal.Infrastructure.csproj" />
  </ItemGroup>

</Project>
