{
  // ConnectionStrings live in this file on purpose (accepted exception, audit finding
  // dotnet.production-connection-strings-not-keyvault, 2026-09-21). Every entry authenticates
  // with "Active Directory Default" — the App Service's managed identity — so the strings hold
  // only a server host and database name, never a credential. Key Vault's @Microsoft.KeyVault
  // reference pattern exists to keep secrets out of config; there is no secret here to keep out,
  // and moving hostnames behind a vault lookup would add a runtime dependency without protecting
  // anything. Revisit only if a connection string ever needs a password or key.
  "AllowedHosts": "app-origination-eus.azurewebsites.net;origination.scoular.com",
  "AzureAd": {
    "ClientId": "e1458bcd-7212-4ea0-a836-7e08d03b5bbf",
    "// ClientCredentials": "Mirrors the Dev and QA blocks: how this API proves ITS OWN identity to Entra for the on-behalf-of exchange that turns a caller's token into a Graph token for that same user (Teams channel lookup, Outlook reminders). Needs a federated identity credential on the 'Origination API - Production' registration bound to the app-origination-eus SYSTEM-ASSIGNED managed identity (principal a60a898f-0008-4bca-83a9-5bb05dc9d435), token-exchange audience api://AzureADTokenExchange, PLUS admin consent for delegated Team.ReadBasic.All, Channel.ReadBasic.All and Calendars.ReadWrite on that same registration. Harmless before those exist: with no credential the token acquisition fails and both features degrade to empty/no-op, exactly as they do on a laptop. The client flags for both features were switched on for PROD 2026-09-21 on the basis that the Entra half lands before the 2026-09-22 promotion.",
    "ClientCredentials": [
      {
        "SourceType": "SignedAssertionFromManagedIdentity"
      }
    ]
  },
