# Sample GitHub Actions workflow for Origination
#
# Copy this file to .github/workflows/deploy.yml in your repository.
# Customize the build steps for your project (e.g., Angular build, test steps).
#
# Prerequisites (configured by infrastructure team):
#   - Repository secrets: AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID_NONPROD, AZURE_SUBSCRIPTION_ID_PROD
#   - Environments: dev, qa, prod (with approval gates on qa and prod)
#   - Workload Identity Federation app registration
#
# See GITHUB-ACTIONS-CICD.md for full documentation.

name: Deploy Origination

on:
  push:
    branches: [main]
    paths-ignore:
      - 'developer-docs/**'
      - 'style-guides/**'
      - '*.md'
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        type: choice
        options: [dev, qa, prod]

jobs:
  build:
    runs-on: self-hosted
    # packages: read lets this run's GITHUB_TOKEN install @it/* packages from
    # npm.scoular.ghe.com (e.g. @it/design-system). An explicit permissions:
    # block sets every unlisted scope to none, so this line is REQUIRED for
    # `npm ci` to authenticate — even though both repos are in the IT org and
    # the package is internal. Harmless for .NET-only apps that don't consume
    # @it packages. See "npm Registry Authentication" in GITHUB-ACTIONS-CICD.md.
    permissions:
      contents: read
      packages: read
    steps:
      - uses: actions/checkout@v5

      - name: Setup .NET
        uses: actions/setup-dotnet@v4
        with:
          dotnet-version: '8.0.x'

      - name: Build and Publish
        run: dotnet publish src/Application.Api -c Release -o ./publish

      - name: Upload artifact
        uses: actions/upload-artifact@v7
        with:
          name: app
          path: ./publish

  deploy-dev:
    needs: build
    runs-on: self-hosted
    environment: dev
    if: github.event_name == 'push' || github.event.inputs.environment == 'dev'
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v7
        with:
          name: app
          path: ./publish

      - name: Azure Login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID_NONPROD }}

      - name: Deploy to Dev
        uses: azure/webapps-deploy@v3
        with:
          app-name: app-origination-dev-eus
          package: ./publish

  deploy-qa:
    needs: deploy-dev
    runs-on: self-hosted
    environment: qa
    if: github.event_name == 'push' || github.event.inputs.environment == 'qa'
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v7
        with:
          name: app
          path: ./publish

      - name: Azure Login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID_NONPROD }}

      - name: Deploy to QA
        uses: azure/webapps-deploy@v3
        with:
          app-name: app-origination-qa-eus
          package: ./publish

  deploy-prod:
    needs: deploy-qa
    runs-on: self-hosted
    environment: prod
    if: github.event_name == 'push' || github.event.inputs.environment == 'prod'
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download artifact
        uses: actions/download-artifact@v7
        with:
          name: app
          path: ./publish

      - name: Azure Login (OIDC)
        uses: azure/login@v3
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID_PROD }}

      - name: Deploy to Prod
        uses: azure/webapps-deploy@v3
        with:
          app-name: app-origination-eus
          package: ./publish
