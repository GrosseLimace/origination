# Sample GitHub Actions workflow for Origination
#
# Copy this file to .github/workflows/deploy.yml in your repository.
# Customize the build steps for your project (e.g., Angular build, test steps).
#
# Prerequisites (configured by infrastructure team):
#   - Repository secrets: AZURE_CLIENT_ID, AZURE_TENANT_ID, AZURE_SUBSCRIPTION_ID_NONPROD, AZURE_SUBSCRIPTION_ID_PROD
#   - Environments: dev, qa, prod (with approval gates on qa and prod)
#   - Workload Identity Federation app registration
#
# Every `uses:` below is pinned to a full commit SHA (not a version tag) with a trailing
# `# vX.Y.Z` comment -- deliberate, not a copy/paste artifact. See "Action Version Pinning" in
# GITHUB-ACTIONS-CICD.md for why, and for the lookup command when you want to bump a version.
#
# See GITHUB-ACTIONS-CICD.md for full documentation.

name: Deploy Origination

# Do NOT add a `pull_request:` trigger to this workflow (or to any job here) without reading
# "Trust Model" in GITHUB-ACTIONS-CICD.md first and talking to the infrastructure team. These
# jobs compile and execute repository code on self-hosted runners with corporate-network reach --
# safe for push/workflow_dispatch (already-merged, already-reviewed code), not automatically safe
# for pull_request (PR-authored code, before review) without a scoped approach.
on:
  push:
    branches: [main]
    paths-ignore:
      - 'developer-docs/**'
      - 'style-guides/**'
      - '*.md'
  workflow_dispatch:
    inputs:
      environment:
        description: 'Environment to deploy'
        required: true
        type: choice
        options: [dev, qa, prod]

jobs:
  build:
    runs-on: self-hosted
    # packages: read lets this run's GITHUB_TOKEN install @it/* packages from
    # npm.scoular.ghe.com (e.g. @it/design-system). An explicit permissions:
    # block sets every unlisted scope to none, so this line is REQUIRED for
    # `npm ci` to authenticate — even though both repos are in the IT org and
    # the package is internal. Harmless for .NET-only apps that don't consume
    # @it packages. See "npm Registry Authentication" in GITHUB-ACTIONS-CICD.md.
    permissions:
      contents: read
      packages: read
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1

      - name: Setup .NET
        uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68  # v6.0.0
        with:
          dotnet-version: '8.0.x'

      - name: Build and Publish
        run: dotnet publish src/Application.Api -c Release -o ./publish

      - name: Upload artifact
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: app
          path: ./publish

  deploy-dev:
    needs: build
    runs-on: self-hosted
    environment: dev
    if: github.event_name == 'push' || github.event.inputs.environment == 'dev'
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: app
          path: ./publish

      - name: Azure Login (OIDC)
        uses: azure/login@858f4093d287a904987dfd22abd163280f939550  # v3.0.1
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID_NONPROD }}

      - name: Deploy to Dev
        uses: azure/webapps-deploy@02a81bead70021f5284939794bcec79c271ab383  # v3.0.8
        with:
          app-name: app-origination-dev-eus
          package: ./publish

  deploy-qa:
    needs: deploy-dev
    runs-on: self-hosted
    environment: qa
    if: github.event_name == 'push' || github.event.inputs.environment == 'qa'
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: app
          path: ./publish

      - name: Azure Login (OIDC)
        uses: azure/login@858f4093d287a904987dfd22abd163280f939550  # v3.0.1
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID_NONPROD }}

      - name: Deploy to QA
        uses: azure/webapps-deploy@02a81bead70021f5284939794bcec79c271ab383  # v3.0.8
        with:
          app-name: app-origination-qa-eus
          package: ./publish

  deploy-prod:
    needs: deploy-qa
    runs-on: self-hosted
    environment: prod
    if: github.event_name == 'push' || github.event.inputs.environment == 'prod'
    permissions:
      id-token: write
      contents: read
    steps:
      - name: Download artifact
        uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c  # v8.0.1
        with:
          name: app
          path: ./publish

      - name: Azure Login (OIDC)
        uses: azure/login@858f4093d287a904987dfd22abd163280f939550  # v3.0.1
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID_PROD }}

      - name: Deploy to Prod
        uses: azure/webapps-deploy@02a81bead70021f5284939794bcec79c271ab383  # v3.0.8
        with:
          app-name: app-origination-eus
          package: ./publish
