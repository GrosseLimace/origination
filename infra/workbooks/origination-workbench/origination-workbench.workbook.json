          {
            "id": "00000000-0000-4000-8000-000000000002",
            "version": "KqlParameterItem/1.0",
            "name": "Environment",
            "label": "Environment",
            "type": 2,
            "isRequired": true,
            "query": "resources\n| where type =~ 'microsoft.web/sites' and name startswith 'app-origination' and name endswith '-eus'\n| extend label = case(name endswith '-dev-eus', 'Dev', name endswith '-qa-eus', 'QA', 'Production')\n| extend sortKey = case(label == 'Production', 0, label == 'QA', 1, 2)\n| project value = id, label, sortKey\n| order by sortKey asc",
