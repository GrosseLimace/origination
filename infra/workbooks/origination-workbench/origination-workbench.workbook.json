    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "traces\n| where timestamp {TimeRange}\n| where message startswith \"Aggregation cycle completed\"\n     or message startswith \"Aggregated weekly logins\"\n     or message startswith \"Refreshed trade unit snapshot\"\n     or message startswith \"Failed to refresh trade unit snapshot\"\n     or message startswith \"Retention cleanup\"\n     or message startswith \"Error during aggregation cycle\"\n     or message startswith \"CTRM keep-warm: maintained\"\n     or (message startswith \"CTRM keep-warm\" and severityLevel >= 2)\n| extend Job = case(message startswith \"CTRM keep-warm\", \"CTRM keep-warm\",\n                    message startswith \"Retention cleanup\", \"Retention cleanup\",\n                    \"Usage rollups\")\n| extend Outcome = case(severityLevel >= 3, \"Failed\", severityLevel == 2, \"Warning\", \"Completed\")\n| project timestamp, Job, Outcome, Message = message\n| order by timestamp desc\n| take 100",
        "size": 0,
        "title": "Other background jobs (usage rollups, retention, CTRM keep-warm)",
        "noDataMessage": "No job completions in this range. Usage rollups run hourly; CTRM keep-warm runs continuously while CTRM is enabled.",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [
          "{AppInsights}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Outcome",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Completed",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Failed",
                    "representation": "failed",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "warning",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "Message",
              "formatter": 0,
              "formatOptions": {
                "customColumnWidthSetting": "60%"
              }
            }
          ]
