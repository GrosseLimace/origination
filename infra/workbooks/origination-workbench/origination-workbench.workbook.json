    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "traces\n| where timestamp {TimeRange}\n| where message startswith \"CustomerSync completed\" or (message has \"CustomerSync\" and severityLevel >= 3)\n| parse message with \"CustomerSync completed in \" ElapsedMs:long \" ms. Customers: \" CustInserted:long \" inserted, \" CustUpdated:long \" updated, \" CustReactivated:long \" reactivated, \" CustDeactivated:long \" deactivated. TradeUnits: \" TuInserted:long \" inserted, \" TuUpdated:long \" updated, \" TuDeactivated:long \" deactivated. \" *\n| project timestamp,\n          Outcome = iff(severityLevel >= 3, \"Failed\", \"Completed\"),\n          ElapsedS = round(ElapsedMs / 1000.0, 1),\n          CustInserted, CustUpdated, CustReactivated, CustDeactivated,\n          TuInserted, TuUpdated, TuDeactivated,\n          Detail = iff(severityLevel >= 3, message, \"\")\n| order by timestamp desc",
        "size": 0,
        "title": "CustomerSync runs (the mass-deactivation guard)",
        "noDataMessage": "No CustomerSync completions in this range. The job runs once at startup and once a day (CustomerSync:RunAtTimeUtc). If it ran and still shows nothing, Information-level traces are not reaching App Insights — see the outage playbook, A4.",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.insights/components",
        "crossComponentResources": [
          "{AppInsights}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Outcome",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "icons",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Completed",
                    "representation": "success",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Failed",
                    "representation": "failed",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
