{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": "origination/infra — instant-share-note Logic App",
    "description": "Instant-share Logic App: when a CRM note is created with @mentions, immediately emails the note to the mentioned people/groups. All external calls use the workflow system-assigned managed identity (no secrets)."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "logic-origination-instant-share-note-dev-eus",
      "metadata": {
        "description": "Name of the Logic App workflow resource."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region. Defaults to the target resource group location."
      }
    },
    "environmentTag": {
      "type": "string",
      "defaultValue": "Dev",
      "allowedValues": [
        "Dev",
        "QA",
        "Prod"
      ],
      "metadata": {
        "description": "Value for the Environment resource tag."
      }
    },
    "sqlServerName": {
      "type": "string",
      "defaultValue": "azrscosqld01.database.windows.net",
      "metadata": {
        "description": "Fully-qualified SQL server name used by the SQL API connection dataset paths."
      }
    },
    "sharedMailbox": {
      "type": "string",
      "defaultValue": "dev-OriginationsApp@scoular.com",
      "metadata": {
        "description": "Shared mailbox (UPN) that Microsoft Graph sendMail sends the shared note as."
      }
    },
    "sqlConnectionName": {
      "type": "string",
      "defaultValue": "sqlshare",
      "metadata": {
        "description": "Name of the Microsoft.Web/connections SQL connection (MSI auth) in the target resource group. Distinct from the daily-recap app's 'sql' connection so the two templates do not fight over the same connection resource."
      }
    }
  },
  "variables": {
    "sqlConnectionId": "[resourceId('Microsoft.Web/connections', parameters('sqlConnectionName'))]",
    "sqlManagedApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/sql')]"
  },
  "resources": [
    {
      "comments": "SQL API connection used by the workflow (managed-identity auth, no stored secret). kind V1 (Consumption); the SQL connector selects MSI via parameterValueSet 'oauthMI'. Server + database are supplied per-action by the connector's v2 dataset paths.",
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('sqlConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "tags": {
        "Application": "Origination",
        "Environment": "[parameters('environmentTag')]",
        "IaC": "True"
      },
      "properties": {
        "displayName": "[parameters('sqlConnectionName')]",
        "parameterValueSet": {
          "name": "oauthMI",
          "values": {}
        },
        "api": {
          "id": "[variables('sqlManagedApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('sqlConnectionName'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "tags": {
        "Application": "Origination",
        "Environment": "[parameters('environmentTag')]",
        "IaC": "True",
        "Team": "Full Stack Development"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "actions": {
            "Initialize_recipient": {
              "inputs": {
                "variables": [
                  {
                    "name": "recipient",
                    "type": "array"
                  }
                ]
              },
              "runAfter": {},
              "type": "InitializeVariable"
            },
            "Condition_Has_Mentions": {
              "actions": {
                "Parse_Mentions": {
                  "inputs": {
                    "content": "@triggerBody()?['Mentions']",
                    "schema": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "type": {
                            "type": "string"
                          },
                          "email": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "type"
                        ]
                      }
                    }
                  },
                  "runAfter": {},
                  "type": "ParseJson"
                },
                "Get_Customer": {
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sql']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sqlServerName')))},@{encodeURIComponent(encodeURIComponent('Origination'))}/tables/@{encodeURIComponent(encodeURIComponent('[dbo].[Customer]'))}/items/@{encodeURIComponent(encodeURIComponent(triggerBody()?['CustomerId']))}"
                  },
                  "runAfter": {
                    "Parse_Mentions": [
                      "Succeeded"
                    ]
                  },
                  "type": "ApiConnection"
                },
                "Get_Author": {
                  "inputs": {
                    "host": {
                      "connection": {
                        "name": "@parameters('$connections')['sql']['connectionId']"
                      }
                    },
                    "method": "get",
                    "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sqlServerName')))},@{encodeURIComponent(encodeURIComponent('Entitlements'))}/tables/@{encodeURIComponent(encodeURIComponent('[dbo].[Users]'))}/items/@{encodeURIComponent(encodeURIComponent(first(split(triggerBody()?['CreatedBy'],'@'))))}"
                  },
                  "runAfter": {
                    "Get_Customer": [
                      "Succeeded"
                    ]
                  },
                  "type": "ApiConnection"
                },
                "For_each_Mention": {
                  "actions": {
                    "Switch_Member_Type": {
                      "cases": {
                        "Case_person": {
                          "actions": {
                            "Append_Person_Recipient": {
                              "comment": "Defense-in-depth (M-025 / CWE-284): both the persisted 'email' AND 'id' are untrusted (client-authored). The recipient domain is therefore STRUCTURAL — take only the local part of the id (everything before the first '@') and append the internal domain, so the address is always @scoular.com by construction and a forged id like 'attacker@evil.com' degrades to the harmless internal 'attacker@scoular.com' instead of leaving the tenant. The API additionally rejects non-internal ids on write; this expression keeps the Logic App safe for any pre-existing row.",
                              "inputs": {
                                "name": "recipient",
                                "value": {
                                  "emailAddress": {
                                    "address": "@{concat(if(contains(item()?['id'], '@'), split(item()?['id'], '@')[0], item()?['id']), '@scoular.com')}"
                                  }
                                }
                              },
                              "type": "AppendToArrayVariable"
                            }
                          },
                          "case": "person"
                        },
                        "Case_trade-unit": {
                          "actions": {
                            "Get_Trade_Unit_Members": {
                              "inputs": {
                                "host": {
                                  "connection": {
                                    "name": "@parameters('$connections')['sql']['connectionId']"
                                  }
                                },
                                "method": "get",
                                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sqlServerName')))},@{encodeURIComponent(encodeURIComponent('Entitlements'))}/tables/@{encodeURIComponent(encodeURIComponent('[dbo].[UserTradeUnitAssignments]'))}/items",
                                "queries": {
                                  "$filter": "TradeUnitCode eq @{item()?['id']}"
                                }
                              },
                              "type": "ApiConnection"
                            },
                            "For_each_Trade_Unit_Member": {
                              "actions": {
                                "Append_Trade_Unit_Recipient": {
                                  "inputs": {
                                    "name": "recipient",
                                    "value": {
                                      "emailAddress": {
                                        "address": "@{item()?['UserId']}@scoular.com"
                                      }
                                    }
                                  },
                                  "type": "AppendToArrayVariable"
                                }
                              },
                              "foreach": "@body('Get_Trade_Unit_Members')?['value']",
                              "runAfter": {
                                "Get_Trade_Unit_Members": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Foreach"
                            }
                          },
                          "case": "trade-unit"
                        },
                        "Case_trade-unit-group": {
                          "actions": {
                            "Get_Trade_Unit_Group_Members": {
                              "inputs": {
                                "host": {
                                  "connection": {
                                    "name": "@parameters('$connections')['sql']['connectionId']"
                                  }
                                },
                                "method": "get",
                                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sqlServerName')))},@{encodeURIComponent(encodeURIComponent('Entitlements'))}/tables/@{encodeURIComponent(encodeURIComponent('[dbo].[UserGroupAssignments]'))}/items",
                                "queries": {
                                  "$filter": "GroupId eq @{item()?['id']}"
                                }
                              },
                              "type": "ApiConnection"
                            },
                            "For_each_Group_Member": {
                              "actions": {
                                "Append_Group_Recipient": {
                                  "inputs": {
                                    "name": "recipient",
                                    "value": {
                                      "emailAddress": {
                                        "address": "@{item()?['UserId']}@scoular.com"
                                      }
                                    }
                                  },
                                  "type": "AppendToArrayVariable"
                                }
                              },
                              "foreach": "@body('Get_Trade_Unit_Group_Members')?['value']",
                              "runAfter": {
                                "Get_Trade_Unit_Group_Members": [
                                  "Succeeded"
                                ]
                              },
                              "type": "Foreach"
                            }
                          },
                          "case": "trade-unit-group"
                        }
                      },
                      "default": {
                        "actions": {}
                      },
                      "expression": "@item()?['type']",
                      "type": "Switch"
                    }
                  },
                  "foreach": "@body('Parse_Mentions')",
                  "runAfter": {
                    "Get_Author": [
                      "Succeeded",
                      "Failed"
                    ]
                  },
                  "type": "Foreach"
                },
                "Compose_Recipients": {
                  "inputs": "@union(variables('recipient'), variables('recipient'))",
                  "runAfter": {
                    "For_each_Mention": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose"
                },
                "Condition_Has_Recipients": {
                  "actions": {
                    "HTTP_Send_Share_Email": {
                      "inputs": {
                        "authentication": {
                          "audience": "https://graph.microsoft.com",
                          "type": "ManagedServiceIdentity"
                        },
                        "body": {
                          "message": {
                            "body": {
                              "content": "<!doctype html>\n<html>\n  <head>\n    <meta name=\"viewport\" content=\"width=device-width\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n    <title>You were mentioned in a note</title>\n    <style>\n    @media only screen and (max-width: 620px) {\n      table[class=body] h1 { font-size: 22px !important; }\n      table[class=body] p, table[class=body] td, table[class=body] span, table[class=body] a { font-size: 16px !important; }\n      table[class=body] .wrapper { padding: 16px !important; }\n      table[class=body] .container { padding: 0 !important; width: 100% !important; }\n      table[class=body] .main { border-radius: 0 !important; }\n      table[class=body] .img-responsive { height: auto !important; max-width: 100% !important; }\n    }\n    @media all {\n      .ExternalClass { width: 100%; }\n      .ExternalClass, .ExternalClass p, .ExternalClass span, .ExternalClass font, .ExternalClass td, .ExternalClass div { line-height: 100%; }\n      #MessageViewBody a { color: inherit; text-decoration: none; }\n    }\n    </style>\n  </head>\n  <body class=\"\" style=\"background-color: #f6f6f6; font-family: 'Open Sans', Arial, sans-serif; -webkit-font-smoothing: antialiased; font-size: 14px; line-height: 1.5; margin: 0; padding: 0;\">\n    <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" class=\"body\" style=\"border-collapse: separate; width: 100%; background-color: #f6f6f6;\">\n      <tr>\n        <td>&nbsp;</td>\n        <td class=\"container\" style=\"display: block; margin: 0 auto; max-width: 580px; padding: 10px; width: 580px;\">\n          <div class=\"content\" style=\"box-sizing: border-box; display: block; margin: 0 auto; max-width: 580px; padding: 10px;\">\n            <table class=\"main\" style=\"border-collapse: separate; width: 100%; background: #ffffff; border-radius: 6px; border-top: 4px solid #007CC0;\">\n              <tr>\n                <td style=\"padding:0; line-height:0; font-size:0;\">\n                  <img src=\"https://www.scoular.com/wp-content/uploads/2023/09/MicrosoftTeams-image-6.png\" alt=\"Scoular\" width=\"580\" class=\"img-responsive\" style=\"width:100%; max-width:100%; height:auto; display:block; border:0; border-radius:6px 6px 0 0;\" />\n                </td>\n              </tr>\n              <tr>\n                <td class=\"wrapper\" style=\"box-sizing: border-box; padding: 28px;\">\n\n                  <h1 style=\"color:#00395D; font-family:'Open Sans', Arial, sans-serif; font-size:22px; font-weight:700; margin:0 0 12px 0;\">You were mentioned in a note</h1>\n\n                  <p style=\"color:#576269; font-size:15px; margin:0 0 18px 0;\">\n                    <strong style=\"color:#00395D;\">@{coalesce(body('Get_Author')?['DisplayName'], triggerBody()?['CreatedBy'])}</strong>\n                    mentioned you in a note regarding\n                    <strong style=\"color:#00395D;\">@{coalesce(body('Get_Customer')?['CustomerName'], 'a customer')}</strong>.\n                  </p>\n\n                  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%; margin:0 0 20px 0;\">\n                    <tr><td style=\"background:#FBF7E2; border-left:4px solid #E8B30D; padding:14px 16px; border-radius:4px; color:#111827; font-size:15px; line-height:1.5; white-space:pre-wrap;\">@{triggerBody()?['Description']}</td></tr>\n                  </table>\n\n                  <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%; border-collapse:collapse; font-size:14px;\">\n                    <tr>\n                      <td style=\"padding:8px 0; color:#576269; font-weight:700; width:110px; vertical-align:top;\">Regarding</td>\n                      <td style=\"padding:8px 0; color:#111827; vertical-align:top;\">@{coalesce(body('Get_Customer')?['CustomerName'], '')}</td>\n                    </tr>\n                    <tr>\n                      <td style=\"padding:8px 0; color:#576269; font-weight:700; vertical-align:top;\">From</td>\n                      <td style=\"padding:8px 0; color:#111827; vertical-align:top;\">@{coalesce(body('Get_Author')?['DisplayName'], triggerBody()?['CreatedBy'])}</td>\n                    </tr>\n                    <tr>\n                      <td style=\"padding:8px 0; color:#576269; font-weight:700; vertical-align:top;\">Created</td>\n                      <td style=\"padding:8px 0; color:#111827; vertical-align:top;\">@{formatDateTime(convertFromUtc(concat(triggerBody()?['CreatedAt'],'Z'),'Central Standard Time'),'M/d/yyyy h:mm tt')} CT</td>\n                    </tr>\n                  </table>\n\n                </td>\n              </tr>\n            </table>\n\n            <div class=\"footer\" style=\"text-align:center; width:100%; margin-top:12px;\">\n              <p style=\"color:#8a949b; font-size:12px; margin:0;\">Sent by the Scoular Origination App</p>\n            </div>\n\n          </div>\n        </td>\n        <td>&nbsp;</td>\n      </tr>\n    </table>\n  </body>\n</html>",
                              "contentType": "HTML"
                            },
                            "subject": "@{coalesce(body('Get_Author')?['DisplayName'], triggerBody()?['CreatedBy'])} mentioned you in a note on @{coalesce(body('Get_Customer')?['CustomerName'], 'a customer')}",
                            "toRecipients": "@outputs('Compose_Recipients')"
                          },
                          "saveToSentItems": true
                        },
                        "method": "POST",
                        "uri": "https://graph.microsoft.com/v1.0/users/@{parameters('sharedMailbox')}/sendMail"
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      },
                      "type": "Http"
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "greater": [
                          "@length(outputs('Compose_Recipients'))",
                          0
                        ]
                      }
                    ]
                  },
                  "runAfter": {
                    "Compose_Recipients": [
                      "Succeeded"
                    ]
                  },
                  "type": "If"
                }
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "greater": [
                      "@length(trim(coalesce(triggerBody()?['Mentions'], '')))",
                      0
                    ]
                  },
                  {
                    "not": {
                      "equals": [
                        "@coalesce(triggerBody()?['IsDeleted'], false)",
                        true
                      ]
                    }
                  }
                ]
              },
              "runAfter": {
                "Initialize_recipient": [
                  "Succeeded"
                ]
              },
              "type": "If"
            }
          },
          "contentVersion": "1.0.0.0",
          "outputs": {},
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            },
            "sharedMailbox": {
              "defaultValue": "dev-OriginationsApp@scoular.com",
              "type": "String"
            },
            "sqlServerName": {
              "defaultValue": "azrscosqld01.database.windows.net",
              "type": "String"
            }
          },
          "triggers": {
            "When_a_note_is_created": {
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['sql']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent(parameters('sqlServerName')))},@{encodeURIComponent(encodeURIComponent('Origination'))}/tables/@{encodeURIComponent(encodeURIComponent('[dbo].[Notes]'))}/onnewitems"
              },
              "recurrence": {
                "frequency": "Minute",
                "interval": 3
              },
              "splitOn": "@triggerBody()?['value']",
              "type": "ApiConnection"
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "sql": {
                "connectionId": "[variables('sqlConnectionId')]",
                "connectionName": "[parameters('sqlConnectionName')]",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                },
                "id": "[variables('sqlManagedApiId')]"
              }
            }
          },
          "sharedMailbox": {
            "value": "[parameters('sharedMailbox')]"
          },
          "sqlServerName": {
            "value": "[parameters('sqlServerName')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'full').identity.principalId]"
    }
  }
}
