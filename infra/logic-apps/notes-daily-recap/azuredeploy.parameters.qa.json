{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": { "value": "logic-origination-notes-daily-recap-qa-eus" },
    "location": { "value": "eastus" },
    "environmentTag": { "value": "QA" },
    "sqlServerName": { "value": "azrscosqlq01.database.windows.net" },
    "sharedMailbox": { "value": "qa-OriginationsApp@scoular.com" },
    // Named "sqlrecap" (not "sql") to sidestep an orphaned V2 "sql" connection left in the QA RG by an
    // earlier failed deploy that we lack rights to delete. Creates a fresh V1 connection under this name.
    "sqlConnectionName": { "value": "sqlrecap" },
    // aiFoundryEndpoint: QA's own Azure AI Foundry resource (gpt-5.1). Mirrors the per-env naming
    // sco-aif-origination-<env>-eus. ⚠️ Confirm this resource + deployment exist before deploying QA.
    "aiFoundryEndpoint": { "value": "https://sco-aif-origination-qa-eus.cognitiveservices.azure.com/openai/deployments/gpt-5.1/chat/completions?api-version=2025-01-01-preview" }
  }
}
