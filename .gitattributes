# FD-CIC data packs: manifest.json holds a SHA-256 of each file's exact bytes, so keep them LF on
# every checkout (core.autocrlf would otherwise convert them and break the hashes).
api/GrainOriginatorPortal.Api/Content/FdCic/** text eol=lf
# USDA T-DISC data packs: the same, for the same reason.
api/GrainOriginatorPortal.Api/Content/TDisc/** text eol=lf
