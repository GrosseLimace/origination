@namespace GrainOriginatorPortal.Components.Features.Storage

<div class="space-y-4">
    @if (!StoredGrain.Any())
    {
        <div class="text-center py-8 text-gray-500 dark:text-gray-400">
            <Icon Name="warehouse" Size="48" Class="mx-auto mb-4 opacity-50" />
            <p>No grain currently in storage for this customer</p>
        </div>
    }
    else
    {
        <!-- Total Storage Cost Banner -->
        <div class="mt-2 mb-4 p-4 rounded-lg bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800">
            <p class="text-sm text-blue-600 dark:text-blue-400">Total Accumulated Storage Costs</p>
            <p class="text-2xl text-blue-700 dark:text-blue-300">$@totalStorageCost.ToString("N2")</p>
        </div>

        <!-- Mobile Card View -->
        <div class="md:hidden space-y-3">
            @foreach (var grain in sortedGrain)
            {
                var costs = CalculateStorageCost(grain);

                <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 bg-white dark:bg-gray-800">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex-1">
                            <div class="font-medium text-gray-900 dark:text-white">@grain.Crop</div>
                            <div class="text-sm text-gray-500 dark:text-gray-400">@grain.Bin</div>
                        </div>
                        <div class="text-sm font-medium text-red-600 dark:text-red-400">
                            $@costs.TotalCost.ToString("N2")
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Quantity</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @grain.Quantity.ToString("N0") bu
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Storage Rate</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                $@grain.StorageRate.ToString("F3")/bu/mo
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Start Date</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @grain.StorageStartDate.ToString("MMM d, yyyy")
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Time in Storage</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @costs.MonthsStored.ToString("F1") mo
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Table View -->
        <div class="hidden md:block">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Crop)">
                            Crop
                            @SortIconFragment(SortColumn.Crop)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Quantity)">
                            Quantity (bu)
                            @SortIconFragment(SortColumn.Quantity)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Bin)">
                            Bin
                            @SortIconFragment(SortColumn.Bin)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.StorageRate)">
                            Storage Rate
                            @SortIconFragment(SortColumn.StorageRate)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.StartDate)">
                            Start Date
                            @SortIconFragment(SortColumn.StartDate)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.AccumulatedCost)">
                            Accumulated Cost
                            @SortIconFragment(SortColumn.AccumulatedCost)
                        </TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var grain in sortedGrain)
                    {
                        var costs = CalculateStorageCost(grain);
                        var isExpanded = expandedRows.Contains(grain.Id);
                        var monthlyCharge = grain.StorageRate * grain.Quantity;

                        <TableRow>
                            <TableCell>
                                <div class="flex items-center gap-2">
                                    <button type="button"
                                            class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 border-0 bg-transparent p-0"
                                            @onclick="() => ToggleRow(grain.Id)">
                                        @if (isExpanded)
                                        {
                                            <Icon Name="chevron-up" Size="16" />
                                        }
                                        else
                                        {
                                            <Icon Name="chevron-down" Size="16" />
                                        }
                                    </button>
                                    <span class="font-medium">@grain.Crop</span>
                                </div>
                            </TableCell>
                            <TableCell>@grain.Quantity.ToString("N0")</TableCell>
                            <TableCell>@grain.Bin</TableCell>
                            <TableCell>$@grain.StorageRate.ToString("F3")/bu/mo</TableCell>
                            <TableCell>@grain.StorageStartDate.ToString("MMM d, yyyy")</TableCell>
                            <TableCell Class="text-red-600 dark:text-red-400 font-medium">
                                $@costs.TotalCost.ToString("N2")
                            </TableCell>
                        </TableRow>

                        @if (isExpanded)
                        {
                            <TableRow Class="bg-gray-50 dark:bg-gray-800/50">
                                <TableCell colspan="6">
                                    <div class="py-4">
                                        <!-- Two column layout -->
                                        <div class="grid grid-cols-2 gap-8">
                                            <!-- Left column -->
                                            <div class="space-y-6">
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Storage Start Date</p>
                                                    <p>@grain.StorageStartDate.ToString("MMMM d, yyyy")</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Monthly Charge</p>
                                                    <p>$@monthlyCharge.ToString("N2")</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Storage Rate</p>
                                                    <p>$@grain.StorageRate.ToString("F3") per bushel per month</p>
                                                </div>
                                            </div>

                                            <!-- Right column -->
                                            <div class="space-y-6">
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Time in Storage</p>
                                                    <p>@costs.MonthsStored.ToString("F1") months</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Total Bushels</p>
                                                    <p>@grain.Quantity.ToString("N0") bushels</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Total Cost to Date</p>
                                                    <p class="text-red-600 dark:text-red-400 font-medium">$@costs.TotalCost.ToString("N2")</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </TableCell>
                            </TableRow>
                        }
                    }
                </TableBody>
            </Table>
        </div>
    }
</div>

@code {
    [Parameter] public List<StoredGrain> StoredGrain { get; set; } = new();

    private HashSet<string> expandedRows = new();
    private SortColumn? currentSortColumn;
    private SortDirection currentSortDirection = SortDirection.None;

    private enum SortColumn { Crop, Quantity, Bin, StorageRate, StartDate, AccumulatedCost }
    private enum SortDirection { None, Ascending, Descending }

    private decimal totalStorageCost => StoredGrain.Sum(g => CalculateStorageCost(g).TotalCost);

    private IEnumerable<StoredGrain> sortedGrain
    {
        get
        {
            if (currentSortColumn == null || currentSortDirection == SortDirection.None)
                return StoredGrain;

            var sorted = currentSortColumn switch
            {
                SortColumn.Crop => StoredGrain.OrderBy(g => g.Crop),
                SortColumn.Quantity => StoredGrain.OrderBy(g => g.Quantity),
                SortColumn.Bin => StoredGrain.OrderBy(g => g.Bin),
                SortColumn.StorageRate => StoredGrain.OrderBy(g => g.StorageRate),
                SortColumn.StartDate => StoredGrain.OrderBy(g => g.StorageStartDate),
                SortColumn.AccumulatedCost => StoredGrain.OrderBy(g => CalculateStorageCost(g).TotalCost),
                _ => StoredGrain.AsEnumerable()
            };

            return currentSortDirection == SortDirection.Descending ? sorted.Reverse() : sorted;
        }
    }

    private void HandleSort(SortColumn column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection switch
            {
                SortDirection.None => SortDirection.Ascending,
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None
            };

            if (currentSortDirection == SortDirection.None)
                currentSortColumn = null;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = SortDirection.Ascending;
        }
    }

    private void ToggleRow(string id)
    {
        if (!expandedRows.Remove(id))
            expandedRows.Add(id);
    }

    private (decimal TotalCost, double MonthsStored) CalculateStorageCost(StoredGrain grain)
    {
        var monthsStored = (DateTime.Now.Year - grain.StorageStartDate.Year) * 12
                         + (DateTime.Now.Month - grain.StorageStartDate.Month)
                         + (DateTime.Now.Day / 30.0);
        var totalCost = (decimal)monthsStored * grain.StorageRate * grain.Quantity;
        return (totalCost, monthsStored);
    }

    private RenderFragment SortIconFragment(SortColumn column)
    {
        return builder =>
        {
            var iconName = "arrow-up-down";
            var iconClass = "size-3 ml-1 inline-block opacity-40";

            if (currentSortColumn == column)
            {
                iconClass = "size-3 ml-1 inline-block";
                iconName = currentSortDirection == SortDirection.Ascending ? "arrow-up" : "arrow-down";
            }

            builder.OpenComponent<Icon>(0);
            builder.AddAttribute(1, "Name", iconName);
            builder.AddAttribute(2, "Size", 12);
            builder.AddAttribute(3, "Class", iconClass);
            builder.CloseComponent();
        };
    }
}
