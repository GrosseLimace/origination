@namespace GrainOriginatorPortal.Components.Features.Customers
@inject IDataService DataService

<Card>
    <CardHeader>
        <CardTitle>Customers</CardTitle>
        <CardDescription>@customers.Count producers in your territory</CardDescription>
    </CardHeader>
    <CardContent Class="p-0">
        <!-- Search -->
        <div class="p-4 border-b">
            <SearchInput Value="@searchQuery"
                         ValueChanged="HandleSearch"
                         Placeholder="Search customers..."
                         DebounceMs="300" />
        </div>

        <!-- Saved Lists Filter -->
        @if (SavedLists.Any())
        {
            <div class="p-4 border-b flex-shrink-0">
                <Select Value="@selectedListId"
                        ValueChanged="HandleListFilter"
                        Placeholder="Filter by saved list">
                    <SelectOption Value="">All Customers</SelectOption>
                    @foreach (var list in SavedLists)
                    {
                        <SelectOption Value="@list.Id">@list.Name (@list.CustomerIds.Count)</SelectOption>
                    }
                </Select>
            </div>
        }

        <!-- Customer List -->
        <div class="divide-y divide-gray-200 dark:divide-gray-700">
            @if (!filteredCustomers.Any())
            {
                <div class="p-8 text-center text-gray-500">
                    <Icon Name="users" Size="48" Class="mx-auto mb-4 opacity-50" />
                    <p>No customers found</p>
                </div>
            }
            else
            {
                @foreach (var customer in filteredCustomers)
                {
                    var lastContact = GetLastContactInfo(customer.Id);

                    <div class="@GetCustomerItemClass(customer)" @onclick="() => HandleSelectCustomer(customer)">
                        <!-- Row 1: Name and Acres -->
                        <div class="flex items-center justify-between">
                            <h3 class="font-medium text-gray-900 dark:text-white truncate">
                                @customer.Name
                            </h3>
                            <Badge Variant="secondary">@customer.TotalAcres.ToString("N0") acres</Badge>
                        </div>

                        <!-- Rows 2-5 with larger spacing -->
                        <div class="space-y-40 mt-2">
                            <!-- Row 2: Farm -->
                            <p class="text-sm text-gray-600 dark:text-gray-400 truncate">
                                @customer.Farm
                            </p>

                            <!-- Row 3: Location -->
                            <div class="flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
                                <Icon Name="map-pin" Size="14" />
                                <span class="truncate">@customer.Location</span>
                            </div>

                            <!-- Row 4: Phone -->
                            @if (!string.IsNullOrEmpty(customer.Phone))
                            {
                                <div class="flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
                                    <Icon Name="phone" Size="14" />
                                    <span>@customer.Phone</span>
                                </div>
                            }

                            <!-- Row 5: Last Contact -->
                            <div class="flex items-center gap-1.5 text-sm @GetLastContactClass(lastContact.DaysAgo)">
                                <Icon Name="calendar" Size="14" />
                                <span>@lastContact.Text</span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </CardContent>
</Card>

@code {
    [Parameter] public Customer? SelectedCustomer { get; set; }
    [Parameter] public EventCallback<Customer> OnSelectCustomer { get; set; }
    [Parameter] public List<SavedList> SavedLists { get; set; } = new();

    private List<Customer> customers = new();
    private List<Customer> filteredCustomers = new();
    private List<Note> allNotes = new();
    private string searchQuery = "";
    private string selectedListId = "";

    protected override void OnInitialized()
    {
        customers = DataService.GetCustomers();
        allNotes = DataService.GetNotes();
        ApplyFilters();
    }

    private void HandleSearch(string query)
    {
        searchQuery = query;
        ApplyFilters();
    }

    private void HandleListFilter(string listId)
    {
        selectedListId = listId;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var result = customers.AsEnumerable();

        // Apply search filter
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var query = searchQuery.ToLower();
            result = result.Where(c =>
                c.Name.ToLower().Contains(query) ||
                c.Farm.ToLower().Contains(query) ||
                c.Location.ToLower().Contains(query) ||
                c.Email.ToLower().Contains(query));
        }

        // Apply saved list filter
        if (!string.IsNullOrEmpty(selectedListId))
        {
            var savedList = SavedLists.FirstOrDefault(l => l.Id == selectedListId);
            if (savedList != null)
            {
                result = result.Where(c => savedList.CustomerIds.Contains(c.Id));
            }
        }

        filteredCustomers = result.ToList();
    }

    private async Task HandleSelectCustomer(Customer customer)
    {
        await OnSelectCustomer.InvokeAsync(customer);
    }

    private string GetCustomerItemClass(Customer customer)
    {
        var isSelected = SelectedCustomer?.Id == customer.Id;
        var baseClass = "p-4 cursor-pointer transition-colors";
        var stateClass = isSelected
            ? "bg-green-50 dark:bg-green-900/30 border-l-4 border-green-500"
            : "bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700";
        return $"{baseClass} {stateClass}";
    }

    private (string Text, int DaysAgo) GetLastContactInfo(string customerId)
    {
        var customerNotes = allNotes.Where(n => n.CustomerId == customerId).OrderByDescending(n => n.Timestamp);
        var lastNote = customerNotes.FirstOrDefault();

        if (lastNote == null)
        {
            return ("No contact", -1);
        }

        var daysAgo = (int)(DateTime.Now - lastNote.Timestamp).TotalDays;

        if (daysAgo == 0)
            return ("Today", 0);
        if (daysAgo == 1)
            return ("Yesterday", 1);
        if (daysAgo < 7)
            return ($"{daysAgo} days ago", daysAgo);
        if (daysAgo < 30)
            return ($"{daysAgo / 7} weeks ago", daysAgo);
        if (daysAgo < 365)
            return ($"{daysAgo / 30} months ago", daysAgo);

        return ($"{daysAgo / 365} years ago", daysAgo);
    }

    private string GetLastContactClass(int daysAgo)
    {
        if (daysAgo < 0) return "text-red-500";
        if (daysAgo <= 7) return "text-green-500";
        if (daysAgo <= 30) return "text-yellow-500";
        return "text-red-500";
    }
}
