@namespace GrainOriginatorPortal.Components.Features.Customers

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Contract Status Pie Chart -->
    <Card>
        <CardHeader>
            <CardTitle>Contract Status</CardTitle>
            <CardDescription>Distribution by status</CardDescription>
        </CardHeader>
        <CardContent>
            @if (contractStatusData.Any())
            {
                <ApexChart TItem="ChartDataItem"
                           Title=""
                           Options="@pieChartOptions"
                           @ref="contractStatusChart">
                    <ApexPointSeries TItem="ChartDataItem"
                                     Items="@contractStatusData"
                                     SeriesType="SeriesType.Pie"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Value)"
                                     OrderBy="e => e.X" />
                </ApexChart>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <Icon Name="pie-chart" Size="48" Class="mx-auto mb-4 opacity-50" />
                    <p>No contract data available</p>
                </div>
            }
        </CardContent>
    </Card>

    <!-- Crop Acreage Bar Chart -->
    <Card>
        <CardHeader>
            <CardTitle>Planned Acreage by Crop</CardTitle>
            <CardDescription>From planting intentions</CardDescription>
        </CardHeader>
        <CardContent>
            @if (cropAcreageData.Any())
            {
                <ApexChart TItem="ChartDataItem"
                           Title=""
                           Options="@barChartOptions"
                           @ref="cropAcreageChart">
                    <ApexPointSeries TItem="ChartDataItem"
                                     Items="@cropAcreageData"
                                     SeriesType="SeriesType.Bar"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Value)"
                                     OrderBy="e => e.X" />
                </ApexChart>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <Icon Name="bar-chart" Size="48" Class="mx-auto mb-4 opacity-50" />
                    <p>No planting data available</p>
                </div>
            }
        </CardContent>
    </Card>

    <!-- Monthly Deliveries Line Chart -->
    <Card Class="lg:col-span-2">
        <CardHeader>
            <CardTitle>Delivery Volume</CardTitle>
            <CardDescription>Net weight delivered over time</CardDescription>
        </CardHeader>
        <CardContent>
            @if (deliveryData.Any())
            {
                <ApexChart TItem="ChartDataItem"
                           Title=""
                           Options="@lineChartOptions"
                           @ref="deliveryChart">
                    <ApexPointSeries TItem="ChartDataItem"
                                     Items="@deliveryData"
                                     SeriesType="SeriesType.Area"
                                     Name="Net Weight (lbs)"
                                     XValue="@(e => e.Label)"
                                     YValue="@(e => e.Value)"
                                     OrderBy="e => e.X" />
                </ApexChart>
            }
            else
            {
                <div class="text-center py-8 text-gray-500">
                    <Icon Name="line-chart" Size="48" Class="mx-auto mb-4 opacity-50" />
                    <p>No delivery data available</p>
                </div>
            }
        </CardContent>
    </Card>
</div>

@code {
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<Ticket> Tickets { get; set; } = new();
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public bool IsDarkMode { get; set; }

    private ApexChart<ChartDataItem>? contractStatusChart;
    private ApexChart<ChartDataItem>? cropAcreageChart;
    private ApexChart<ChartDataItem>? deliveryChart;

    private class ChartDataItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
        public int X { get; set; }
    }

    private List<ChartDataItem> contractStatusData = new();
    private List<ChartDataItem> cropAcreageData = new();
    private List<ChartDataItem> deliveryData = new();

    private ApexChartOptions<ChartDataItem> pieChartOptions = new();
    private ApexChartOptions<ChartDataItem> barChartOptions = new();
    private ApexChartOptions<ChartDataItem> lineChartOptions = new();

    protected override void OnInitialized()
    {
        LoadChartData();
        ConfigureChartOptions();
    }

    protected override void OnParametersSet()
    {
        LoadChartData();
        ConfigureChartOptions();
    }

    private void LoadChartData()
    {
        // Contract Status Data
        var statusGroups = Contracts
            .GroupBy(c => c.Status)
            .Select((g, i) => new ChartDataItem
            {
                Label = g.Key.ToString(),
                Value = g.Count(),
                X = i
            })
            .ToList();
        contractStatusData = statusGroups;

        // Crop Acreage Data
        var cropGroups = PlantingIntentions
            .GroupBy(p => p.Crop)
            .Select((g, i) => new ChartDataItem
            {
                Label = g.Key,
                Value = g.Sum(p => p.Acres),
                X = i
            })
            .OrderByDescending(c => c.Value)
            .ToList();
        cropAcreageData = cropGroups;

        // Delivery Data (group by month)
        var deliveryGroups = Tickets
            .GroupBy(t => new { t.Date.Year, t.Date.Month })
            .OrderBy(g => g.Key.Year)
            .ThenBy(g => g.Key.Month)
            .Select((g, i) => new ChartDataItem
            {
                Label = $"{g.Key.Month}/{g.Key.Year}",
                Value = g.Sum(t => t.NetWeight),
                X = i
            })
            .ToList();
        deliveryData = deliveryGroups;
    }

    private void ConfigureChartOptions()
    {
        var foregroundColor = IsDarkMode ? "#f5f5f5" : "#171717";
        var backgroundColor = IsDarkMode ? "#171717" : "#ffffff";
        var gridColor = IsDarkMode ? "#374151" : "#e5e7eb";

        // Pie Chart Options
        pieChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = foregroundColor
            },
            Colors = new List<string> { "#22c55e", "#3b82f6", "#f59e0b" },
            Legend = new Legend
            {
                Position = LegendPosition.Bottom,
                Labels = new LegendLabels
                {
                    Colors = new Color(foregroundColor)
                }
            },
            Stroke = new Stroke
            {
                Show = false
            }
        };

        // Bar Chart Options
        barChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = foregroundColor,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = new List<string> { "#22c55e" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 4,
                    Horizontal = false
                }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle
                    {
                        Colors = new Color(foregroundColor)
                    }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle
                        {
                            Colors = new Color(foregroundColor)
                        }
                    }
                }
            },
            Grid = new Grid
            {
                BorderColor = gridColor
            }
        };

        // Line/Area Chart Options
        lineChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = foregroundColor,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = new List<string> { "#3b82f6" },
            Stroke = new Stroke
            {
                Curve = Curve.Smooth,
                Width = 3
            },
            Fill = new Fill
            {
                Type = new List<FillType> { FillType.Gradient },
                Gradient = new FillGradient
                {
                    ShadeIntensity = 1,
                    OpacityFrom = 0.45,
                    OpacityTo = 0.05
                }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle
                    {
                        Colors = new Color(foregroundColor)
                    }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle
                        {
                            Colors = new Color(foregroundColor)
                        },
                        Formatter = "function(val) { return val.toLocaleString() + ' lbs'; }"
                    }
                }
            },
            Grid = new Grid
            {
                BorderColor = gridColor
            },
            Tooltip = new Tooltip
            {
                Theme = IsDarkMode ? Mode.Dark : Mode.Light
            }
        };
    }
}
