@namespace GrainOriginatorPortal.Components.Features.Customers

<Dialog IsOpen="@IsOpen" IsOpenChanged="HandleClose" Size="md">
    <DialogHeader>
        <DialogTitle>Edit Customer Information</DialogTitle>
        <DialogDescription>Update contact details and manage farm associations for @Customer?.Name</DialogDescription>
    </DialogHeader>

    @if (Customer != null)
    {
        <div class="space-y-6">
            <!-- Contact Information Section -->
            <div class="space-y-4">
                <h4 class="font-medium text-gray-900 dark:text-white">Contact Information</h4>

                <div class="space-y-2">
                    <Label>Location</Label>
                    <Input Type="text"
                           Value="@editLocation"
                           ValueChanged="v => editLocation = v"
                           Placeholder="e.g., Iowa County, IA" />
                </div>

                <div class="space-y-2">
                    <Label>Phone</Label>
                    <Input Type="tel"
                           Value="@editPhone"
                           ValueChanged="v => editPhone = v"
                           Placeholder="e.g., (319) 555-0123" />
                </div>

                <div class="space-y-2">
                    <Label>Email</Label>
                    <Input Type="email"
                           Value="@editEmail"
                           ValueChanged="v => editEmail = v"
                           Placeholder="e.g., john@example.com" />
                </div>
            </div>

            <Separator />

            <!-- Farm Associations Section -->
            <div class="space-y-6">
                <div class="flex items-center justify-between">
                    <h4 class="font-medium text-gray-900 dark:text-white">Farm Associations</h4>
                    <Button Variant="outline" Size="sm" OnClick="() => showNewFarmForm = !showNewFarmForm">
                        <Icon Name="plus" Size="14" Class="mr-1" />
                        New Farm
                    </Button>
                </div>

                <!-- New Farm Form (collapsible) -->
                @if (showNewFarmForm)
                {
                    <div class="p-4 border rounded-lg space-y-4 bg-gray-50 dark:bg-gray-800">
                        <div class="space-y-2">
                            <Label>Farm Name</Label>
                            <Input Type="text"
                                   Value="@newFarmName"
                                   ValueChanged="v => newFarmName = v"
                                   Placeholder="e.g., North Field Farm" />
                        </div>
                        <div class="space-y-2">
                            <Label>Location</Label>
                            <Input Type="text"
                                   Value="@newFarmLocation"
                                   ValueChanged="v => newFarmLocation = v"
                                   Placeholder="e.g., Johnson County, IA" />
                        </div>
                        <div class="space-y-2">
                            <Label>Acres</Label>
                            <Input Type="number"
                                   Value="@newFarmAcres"
                                   ValueChanged="v => newFarmAcres = v"
                                   Placeholder="e.g., 500" />
                        </div>
                        <div class="flex gap-2 mt-4">
                            <Button OnClick="CreateAndAddFarm"
                                    Disabled="@(string.IsNullOrWhiteSpace(newFarmName) || string.IsNullOrWhiteSpace(newFarmAcres))">
                                Add Farm
                            </Button>
                            <Button Variant="outline" OnClick="() => showNewFarmForm = false">
                                Cancel
                            </Button>
                        </div>
                    </div>
                }

                <!-- Current Farms -->
                <div class="space-y-6">
                    @foreach (var farmId in editFarmIds.ToList())
                    {
                        var farm = AllFarms.FirstOrDefault(f => f.Id == farmId);
                        if (farm != null)
                        {
                            <div class="flex items-center justify-between p-3 bg-gray-50 dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700">
                                <div class="space-y-1">
                                    <div class="font-medium text-gray-900 dark:text-white">@farm.Name</div>
                                    <div class="text-sm text-gray-500 dark:text-gray-400">@farm.Location</div>
                                    <div class="text-sm text-gray-500 dark:text-gray-400">@farm.Acres acres</div>
                                </div>
                                @if (editFarmIds.Count > 1)
                                {
                                    <button type="button" @onclick="() => RemoveFarm(farmId)" class="text-red-500 hover:text-red-600 bg-transparent border-0 p-0">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>
                                        </svg>
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>

                <!-- Add Existing Farm -->
                @{
                    var availableFarms = AllFarms.Where(f => !editFarmIds.Contains(f.Id)).ToList();
                }
                @if (availableFarms.Any())
                {
                    <div class="space-y-2">
                        <Label>Add Existing Farm</Label>
                        <Select Value="" ValueChanged="AddExistingFarm" Placeholder="Select a farm to add">
                            @foreach (var farm in availableFarms)
                            {
                                <SelectOption Value="@farm.Id">@farm.Name (@farm.Acres acres)</SelectOption>
                            }
                        </Select>
                    </div>
                }
            </div>

            <DialogFooter>
                <Button Variant="outline" OnClick="() => HandleClose(false)">Cancel</Button>
                <Button OnClick="HandleSave">Save Changes</Button>
            </DialogFooter>
        </div>
    }
</Dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public Customer? Customer { get; set; }
    [Parameter] public List<Farm> AllFarms { get; set; } = new();
    [Parameter] public EventCallback<(string CustomerId, string Location, string Phone, string Email, List<string> FarmIds)> OnSave { get; set; }
    [Parameter] public EventCallback<(string Name, string Location, int Acres)> OnCreateFarm { get; set; }

    private string editLocation = "";
    private string editPhone = "";
    private string editEmail = "";
    private List<string> editFarmIds = new();

    private bool showNewFarmForm = false;
    private string newFarmName = "";
    private string newFarmLocation = "";
    private string newFarmAcres = "";

    protected override void OnParametersSet()
    {
        if (Customer != null && IsOpen)
        {
            editLocation = Customer.Location;
            editPhone = Customer.Phone;
            editEmail = Customer.Email;
            editFarmIds = Customer.FarmIds.ToList();
        }
    }

    private async Task HandleClose(bool isOpen)
    {
        showNewFarmForm = false;
        newFarmName = "";
        newFarmLocation = "";
        newFarmAcres = "";
        await IsOpenChanged.InvokeAsync(isOpen);
    }

    private async Task HandleSave()
    {
        if (Customer != null)
        {
            await OnSave.InvokeAsync((Customer.Id, editLocation, editPhone, editEmail, editFarmIds));
            await HandleClose(false);
        }
    }

    private void AddExistingFarm(string farmId)
    {
        if (!string.IsNullOrEmpty(farmId) && !editFarmIds.Contains(farmId))
        {
            editFarmIds.Add(farmId);
        }
    }

    private void RemoveFarm(string farmId)
    {
        if (editFarmIds.Count > 1)
        {
            editFarmIds.Remove(farmId);
        }
    }

    private async Task CreateAndAddFarm()
    {
        if (!string.IsNullOrWhiteSpace(newFarmName) && int.TryParse(newFarmAcres, out var acres))
        {
            await OnCreateFarm.InvokeAsync((newFarmName, newFarmLocation, acres));

            // The new farm should be added to AllFarms by the parent
            // Find it and add to editFarmIds
            var newFarm = AllFarms.LastOrDefault();
            if (newFarm != null && !editFarmIds.Contains(newFarm.Id))
            {
                editFarmIds.Add(newFarm.Id);
            }

            // Reset form
            showNewFarmForm = false;
            newFarmName = "";
            newFarmLocation = "";
            newFarmAcres = "";
        }
    }
}
