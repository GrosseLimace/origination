@namespace GrainOriginatorPortal.Components.Features.Planting

<div class="space-y-4">
    @if (!PlantingIntentions.Any())
    {
        <div class="space-y-4">
            <div class="text-center py-8 text-gray-500 dark:text-gray-400">
                <Icon Name="calendar" Size="48" Class="mx-auto mb-4 opacity-50" />
                <p>No planting intentions recorded for this customer</p>
            </div>
            <div class="flex justify-center">
                <Button OnClick="() => showAddDialog = true">
                    <Icon Name="plus" Size="16" Class="mr-2" />
                    Add Planting Intention
                </Button>
            </div>
        </div>
    }
    else
    {
        <!-- Add Button -->
        <div class="flex justify-end mb-4">
            <Button OnClick="() => showAddDialog = true">
                <Icon Name="plus" Size="16" Class="mr-2" />
                Add Planting Intention
            </Button>
        </div>

        <!-- Mobile Card View -->
        <div class="md:hidden space-y-3">
            @foreach (var intention in sortedIntentions)
            {
                var totalProduction = intention.Acres * intention.EstimatedYield;
                var daysUntilPlanting = (intention.PlantingDate - DateTime.Now).Days;

                <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 bg-white dark:bg-gray-800">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex-1">
                            <div class="font-medium text-gray-900 dark:text-white">@intention.Crop</div>
                            <div class="text-sm text-gray-500 dark:text-gray-400">@intention.Variety</div>
                        </div>
                        <Button Variant="ghost" Size="icon" OnClick="() => OpenEditDialog(intention)" Class="h-8 w-8">
                            <Icon Name="pencil" Size="16" />
                        </Button>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Acres</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @intention.Acres.ToString("N0")
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Est. Yield</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @intention.EstimatedYield bu/acre
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Total Production</div>
                            <div class="text-sm font-medium text-green-600 dark:text-green-400">
                                @totalProduction.ToString("N0") bu
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Planting Date</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @intention.PlantingDate.ToString("MMM d, yyyy")
                            </div>
                        </div>
                    </div>

                    <div class="mt-3 pt-3 border-t border-gray-200 dark:border-gray-700">
                        <div class="text-xs text-gray-500 dark:text-gray-400">
                            @if (daysUntilPlanting > 0)
                            {
                                <span>@daysUntilPlanting days until planting</span>
                            }
                            else if (daysUntilPlanting == 0)
                            {
                                <span class="text-green-600">Planting today</span>
                            }
                            else
                            {
                                <span>Planted @Math.Abs(daysUntilPlanting) days ago</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Table View -->
        <div class="hidden md:block">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Crop)">
                            Crop
                            @SortIconFragment(SortColumn.Crop)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Acres)">
                            Acres
                            @SortIconFragment(SortColumn.Acres)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Variety)">
                            Variety
                            @SortIconFragment(SortColumn.Variety)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.PlantingDate)">
                            Planting Date
                            @SortIconFragment(SortColumn.PlantingDate)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.EstimatedYield)">
                            Est. Yield (bu/acre)
                            @SortIconFragment(SortColumn.EstimatedYield)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.TotalProduction)">
                            Total Est. Production
                            @SortIconFragment(SortColumn.TotalProduction)
                        </TableHead>
                        <TableHead Class="w-12"></TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var intention in sortedIntentions)
                    {
                        var totalProduction = intention.Acres * intention.EstimatedYield;
                        var isExpanded = expandedRows.Contains(intention.Id);
                        var daysUntilPlanting = (intention.PlantingDate - DateTime.Now).Days;

                        <TableRow>
                            <TableCell>
                                <div class="flex items-center gap-2">
                                    <button type="button"
                                            class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 border-0 bg-transparent p-0"
                                            @onclick="() => ToggleRow(intention.Id)">
                                        @if (isExpanded)
                                        {
                                            <Icon Name="chevron-up" Size="16" />
                                        }
                                        else
                                        {
                                            <Icon Name="chevron-down" Size="16" />
                                        }
                                    </button>
                                    <span class="font-medium">@intention.Crop</span>
                                </div>
                            </TableCell>
                            <TableCell>@intention.Acres.ToString("N0")</TableCell>
                            <TableCell>@intention.Variety</TableCell>
                            <TableCell>@intention.PlantingDate.ToString("MMM d, yyyy")</TableCell>
                            <TableCell>@intention.EstimatedYield</TableCell>
                            <TableCell>@totalProduction.ToString("N0") bu</TableCell>
                            <TableCell>
                                <button type="button"
                                        class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 border-0 bg-transparent p-0"
                                        @onclick="() => OpenEditDialog(intention)">
                                    <Icon Name="pencil" Size="16" />
                                </button>
                            </TableCell>
                        </TableRow>

                        @if (isExpanded)
                        {
                            <TableRow Class="bg-gray-50 dark:bg-gray-800/50">
                                <TableCell colspan="7">
                                    <div class="py-4">
                                        <!-- Two column layout -->
                                        <div class="grid grid-cols-2 gap-8">
                                            <!-- Left column -->
                                            <div class="space-y-6">
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Total Production</p>
                                                    <p>@totalProduction.ToString("N0") bushels</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Yield per Acre</p>
                                                    <p>@intention.EstimatedYield bu/acre</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Full Planting Date</p>
                                                    <p>@intention.PlantingDate.ToString("MMMM d, yyyy")</p>
                                                </div>
                                            </div>

                                            <!-- Right column -->
                                            <div class="space-y-6">
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Planting Timeline</p>
                                                    <p>
                                                        @if (daysUntilPlanting > 0)
                                                        {
                                                            <span>Planting in @daysUntilPlanting days</span>
                                                        }
                                                        else if (daysUntilPlanting == 0)
                                                        {
                                                            <span>Planting today</span>
                                                        }
                                                        else
                                                        {
                                                            <span>Planted @Math.Abs(daysUntilPlanting) days ago</span>
                                                        }
                                                    </p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Variety Details</p>
                                                    <p>@intention.Variety</p>
                                                </div>
                                                <div>
                                                    <p class="text-sm text-gray-500 dark:text-gray-400">Total Acreage</p>
                                                    <p>@intention.Acres.ToString("N0") acres</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </TableCell>
                            </TableRow>
                        }
                    }
                </TableBody>
            </Table>
        </div>
    }

    <!-- Dialogs -->
    <AddPlantingIntentionDialog IsOpen="@showAddDialog"
                                 IsOpenChanged="v => showAddDialog = v"
                                 CustomerName="@CustomerName"
                                 CustomerId="@CustomerId"
                                 FarmId="@FarmId"
                                 OnAdd="HandleAdd" />

    <EditPlantingIntentionDialog IsOpen="@showEditDialog"
                                  IsOpenChanged="v => showEditDialog = v"
                                  CustomerName="@CustomerName"
                                  Intention="@selectedIntention"
                                  OnEdit="HandleEdit" />
</div>

@code {
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public string CustomerName { get; set; } = "";
    [Parameter] public string CustomerId { get; set; } = "";
    [Parameter] public string? FarmId { get; set; }
    [Parameter] public EventCallback<(string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield)> OnAddIntention { get; set; }
    [Parameter] public EventCallback<(string IntentionId, string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield)> OnEditIntention { get; set; }

    private bool showAddDialog = false;
    private bool showEditDialog = false;
    private PlantingIntention? selectedIntention;

    private HashSet<string> expandedRows = new();
    private SortColumn? currentSortColumn;
    private SortDirection currentSortDirection = SortDirection.None;

    private enum SortColumn { Crop, Acres, Variety, PlantingDate, EstimatedYield, TotalProduction }
    private enum SortDirection { None, Ascending, Descending }

    private IEnumerable<PlantingIntention> sortedIntentions
    {
        get
        {
            if (currentSortColumn == null || currentSortDirection == SortDirection.None)
                return PlantingIntentions;

            var sorted = currentSortColumn switch
            {
                SortColumn.Crop => PlantingIntentions.OrderBy(p => p.Crop),
                SortColumn.Acres => PlantingIntentions.OrderBy(p => p.Acres),
                SortColumn.Variety => PlantingIntentions.OrderBy(p => p.Variety),
                SortColumn.PlantingDate => PlantingIntentions.OrderBy(p => p.PlantingDate),
                SortColumn.EstimatedYield => PlantingIntentions.OrderBy(p => p.EstimatedYield),
                SortColumn.TotalProduction => PlantingIntentions.OrderBy(p => p.Acres * p.EstimatedYield),
                _ => PlantingIntentions.AsEnumerable()
            };

            return currentSortDirection == SortDirection.Descending ? sorted.Reverse() : sorted;
        }
    }

    private void HandleSort(SortColumn column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection switch
            {
                SortDirection.None => SortDirection.Ascending,
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None
            };

            if (currentSortDirection == SortDirection.None)
                currentSortColumn = null;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = SortDirection.Ascending;
        }
    }

    private void ToggleRow(string id)
    {
        if (!expandedRows.Remove(id))
            expandedRows.Add(id);
    }

    private void OpenEditDialog(PlantingIntention intention)
    {
        selectedIntention = intention;
        showEditDialog = true;
    }

    private async Task HandleAdd((string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield) data)
    {
        await OnAddIntention.InvokeAsync(data);
    }

    private async Task HandleEdit((string IntentionId, string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield) data)
    {
        await OnEditIntention.InvokeAsync(data);
    }

    private RenderFragment SortIconFragment(SortColumn column)
    {
        return builder =>
        {
            var iconName = "arrow-up-down";
            var iconClass = "size-3 ml-1 inline-block opacity-40";

            if (currentSortColumn == column)
            {
                iconClass = "size-3 ml-1 inline-block";
                iconName = currentSortDirection == SortDirection.Ascending ? "arrow-up" : "arrow-down";
            }

            builder.OpenComponent<Icon>(0);
            builder.AddAttribute(1, "Name", iconName);
            builder.AddAttribute(2, "Size", 12);
            builder.AddAttribute(3, "Class", iconClass);
            builder.CloseComponent();
        };
    }
}
