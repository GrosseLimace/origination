@namespace GrainOriginatorPortal.Components.Features.Planting

<Dialog IsOpen="@IsOpen" IsOpenChanged="HandleClose">
    <DialogHeader>
        <DialogTitle>Edit Planting Intention</DialogTitle>
        <DialogDescription>Update planting intention for @CustomerName</DialogDescription>
    </DialogHeader>

    @if (Intention != null)
    {
        <div class="space-y-4">
            <div class="space-y-2">
                <Label>Crop</Label>
                <Select Value="@crop" ValueChanged="v => crop = v">
                    <SelectOption Value="Corn">Corn</SelectOption>
                    <SelectOption Value="Soybeans">Soybeans</SelectOption>
                    <SelectOption Value="Wheat">Wheat</SelectOption>
                    <SelectOption Value="Oats">Oats</SelectOption>
                </Select>
            </div>

            <div class="space-y-2">
                <Label>Acres</Label>
                <Input Type="number"
                       Value="@acres"
                       ValueChanged="v => acres = v" />
            </div>

            <div class="space-y-2">
                <Label>Variety</Label>
                <Input Type="text"
                       Value="@variety"
                       ValueChanged="v => variety = v" />
            </div>

            <div class="space-y-2">
                <Label>Planting Date</Label>
                <Input Type="date"
                       Value="@plantingDate"
                       ValueChanged="v => plantingDate = v" />
            </div>

            <div class="space-y-2">
                <Label>Estimated Yield (bu/acre)</Label>
                <Input Type="number"
                       Value="@estimatedYield"
                       ValueChanged="v => estimatedYield = v" />
            </div>

            <DialogFooter>
                <Button Variant="outline" OnClick="() => HandleClose(false)">Cancel</Button>
                <Button OnClick="HandleSubmit" Disabled="@(!IsValid)">
                    Save Changes
                </Button>
            </DialogFooter>
        </div>
    }
</Dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string CustomerName { get; set; } = "";
    [Parameter] public PlantingIntention? Intention { get; set; }
    [Parameter] public EventCallback<(string IntentionId, string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield)> OnEdit { get; set; }

    private string crop = "";
    private string acres = "";
    private string variety = "";
    private string plantingDate = "";
    private string estimatedYield = "";

    private bool IsValid => !string.IsNullOrEmpty(crop)
                         && int.TryParse(acres, out _)
                         && !string.IsNullOrEmpty(variety)
                         && DateTime.TryParse(plantingDate, out _)
                         && int.TryParse(estimatedYield, out _);

    protected override void OnParametersSet()
    {
        if (Intention != null && IsOpen)
        {
            crop = Intention.Crop;
            acres = Intention.Acres.ToString();
            variety = Intention.Variety;
            plantingDate = Intention.PlantingDate.ToString("yyyy-MM-dd");
            estimatedYield = Intention.EstimatedYield.ToString();
        }
    }

    private async Task HandleClose(bool isOpen)
    {
        await IsOpenChanged.InvokeAsync(isOpen);
    }

    private async Task HandleSubmit()
    {
        if (IsValid && Intention != null)
        {
            await OnEdit.InvokeAsync((
                Intention.Id,
                crop,
                int.Parse(acres),
                variety,
                DateTime.Parse(plantingDate),
                int.Parse(estimatedYield)
            ));
            await HandleClose(false);
        }
    }
}
