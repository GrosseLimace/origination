@namespace GrainOriginatorPortal.Components.Features.Tickets

<div class="space-y-4">
    @if (!Tickets.Any())
    {
        <div class="text-center py-8 text-gray-500 dark:text-gray-400">
            <Icon Name="truck" Size="48" Class="mx-auto mb-4 opacity-50" />
            <p>No delivery tickets found for this customer</p>
        </div>
    }
    else
    {
        <!-- Mobile Card View -->
        <div class="md:hidden space-y-3">
            @foreach (var ticket in sortedTickets)
            {
                <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-4 bg-white dark:bg-gray-800">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex-1">
                            <div class="font-medium text-gray-900 dark:text-white">@ticket.Crop</div>
                            <div class="text-sm text-gray-500 dark:text-gray-400">Ticket @ticket.Id</div>
                        </div>
                        <div class="text-sm text-gray-500 dark:text-gray-400">
                            @ticket.Date.ToString("MMM d, yyyy")
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Net Weight</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @ticket.NetWeight.ToString("N0") lbs
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Moisture</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @ticket.Moisture.ToString("F1")%
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Test Weight</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @ticket.TestWeight.ToString("F1") lbs/bu
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-gray-500 dark:text-gray-400">Gross Weight</div>
                            <div class="text-sm text-gray-900 dark:text-white">
                                @ticket.GrossWeight.ToString("N0") lbs
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop Table View -->
        <div class="hidden md:block">
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Id)">
                            Ticket ID
                            @SortIconFragment(SortColumn.Id)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Date)">
                            Date
                            @SortIconFragment(SortColumn.Date)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Crop)">
                            Crop
                            @SortIconFragment(SortColumn.Crop)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.NetWeight)">
                            Net Weight (lbs)
                            @SortIconFragment(SortColumn.NetWeight)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Moisture)">
                            Moisture %
                            @SortIconFragment(SortColumn.Moisture)
                        </TableHead>
                        <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.TestWeight)">
                            Test Weight
                            @SortIconFragment(SortColumn.TestWeight)
                        </TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var ticket in sortedTickets)
                    {
                        <TableRow>
                            <TableCell>@ticket.Id</TableCell>
                            <TableCell>@ticket.Date.ToString("MMM d, yyyy")</TableCell>
                            <TableCell>@ticket.Crop</TableCell>
                            <TableCell>@ticket.NetWeight.ToString("N0")</TableCell>
                            <TableCell>@ticket.Moisture.ToString("F1")%</TableCell>
                            <TableCell>@ticket.TestWeight.ToString("F1") lbs/bu</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </div>
    }
</div>

@code {
    [Parameter] public List<Ticket> Tickets { get; set; } = new();

    private SortColumn? currentSortColumn;
    private SortDirection currentSortDirection = SortDirection.None;

    private enum SortColumn { Id, Date, Crop, NetWeight, Moisture, TestWeight }
    private enum SortDirection { None, Ascending, Descending }

    private IEnumerable<Ticket> sortedTickets
    {
        get
        {
            if (currentSortColumn == null || currentSortDirection == SortDirection.None)
                return Tickets;

            var sorted = currentSortColumn switch
            {
                SortColumn.Id => Tickets.OrderBy(t => t.Id),
                SortColumn.Date => Tickets.OrderBy(t => t.Date),
                SortColumn.Crop => Tickets.OrderBy(t => t.Crop),
                SortColumn.NetWeight => Tickets.OrderBy(t => t.NetWeight),
                SortColumn.Moisture => Tickets.OrderBy(t => t.Moisture),
                SortColumn.TestWeight => Tickets.OrderBy(t => t.TestWeight),
                _ => Tickets.AsEnumerable()
            };

            return currentSortDirection == SortDirection.Descending ? sorted.Reverse() : sorted;
        }
    }

    private void HandleSort(SortColumn column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection switch
            {
                SortDirection.None => SortDirection.Ascending,
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None
            };

            if (currentSortDirection == SortDirection.None)
                currentSortColumn = null;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = SortDirection.Ascending;
        }
    }

    private RenderFragment SortIconFragment(SortColumn column)
    {
        return builder =>
        {
            var iconName = "arrow-up-down";
            var iconClass = "size-3 ml-1 inline-block opacity-40";

            if (currentSortColumn == column)
            {
                iconClass = "size-3 ml-1 inline-block";
                iconName = currentSortDirection == SortDirection.Ascending ? "arrow-up" : "arrow-down";
            }

            builder.OpenComponent<Icon>(0);
            builder.AddAttribute(1, "Name", iconName);
            builder.AddAttribute(2, "Size", 12);
            builder.AddAttribute(3, "Class", iconClass);
            builder.CloseComponent();
        };
    }
}
