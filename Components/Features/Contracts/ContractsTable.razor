@namespace GrainOriginatorPortal.Components.Features.Contracts

<div class="space-y-4">
    @if (!Contracts.Any())
    {
        <div class="text-center py-8 text-gray-500 dark:text-gray-400">
            <Icon Name="file-text" Size="48" Class="mx-auto mb-4 opacity-50" />
            <p>No contracts found for this customer</p>
        </div>
    }
    else
    {
        <Table>
            <TableHeader>
                <TableRow>
                    <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.ContractNumber)">
                        Contract ID
                        @SortIconFragment(SortColumn.ContractNumber)
                    </TableHead>
                    <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Crop)">
                        Crop
                        @SortIconFragment(SortColumn.Crop)
                    </TableHead>
                    <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Quantity)">
                        Quantity
                        @SortIconFragment(SortColumn.Quantity)
                    </TableHead>
                    <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Price)">
                        Price
                        @SortIconFragment(SortColumn.Price)
                    </TableHead>
                    <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.DeliveryStart)">
                        Delivery Period
                        @SortIconFragment(SortColumn.DeliveryStart)
                    </TableHead>
                    <TableHead Sortable="true" OnClick="() => HandleSort(SortColumn.Status)">
                        Status
                        @SortIconFragment(SortColumn.Status)
                    </TableHead>
                </TableRow>
            </TableHeader>
            <TableBody>
                @foreach (var contract in sortedContracts)
                {
                    var isExpanded = expandedRows.Contains(contract.Id);
                    var isUnsigned = !contract.Signed;

                    <TableRow Class="@(isUnsigned ? "bg-red-50 dark:bg-red-950/20" : "")">
                        <TableCell>
                            <div class="flex items-center gap-2">
                                <button type="button"
                                        class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 border-0 bg-transparent p-0"
                                        @onclick="() => ToggleRow(contract.Id)">
                                    @if (isExpanded)
                                    {
                                        <Icon Name="chevron-up" Size="16" />
                                    }
                                    else
                                    {
                                        <Icon Name="chevron-down" Size="16" />
                                    }
                                </button>
                                <span class="@(isUnsigned ? "font-medium text-red-600 dark:text-red-400" : "font-medium")">@contract.ContractNumber</span>
                            </div>
                        </TableCell>
                        <TableCell Class="@(isUnsigned ? "text-red-600 dark:text-red-400" : "")">@contract.Crop</TableCell>
                        <TableCell Class="@(isUnsigned ? "text-red-600 dark:text-red-400" : "")">
                            @contract.Quantity.ToString("N0") @contract.Unit
                        </TableCell>
                        <TableCell Class="@(isUnsigned ? "text-red-600 dark:text-red-400" : "")">
                            $@contract.Price.ToString("F2")/@contract.Unit.TrimEnd('s')
                        </TableCell>
                        <TableCell Class="@(isUnsigned ? "text-red-600 dark:text-red-400" : "")">
                            @contract.DeliveryStart.ToString("M/d/yyyy") - @contract.DeliveryEnd.ToString("M/d/yyyy")
                        </TableCell>
                        <TableCell>
                            <span class="@GetStatusClass(contract.Status)">
                                @contract.Status
                            </span>
                        </TableCell>
                    </TableRow>

                    @if (isExpanded)
                    {
                        var deliveryStats = CalculateDeliveryStats(contract);
                        var progressPercent = contract.Quantity > 0 ? (double)deliveryStats.DeliveredBushels / contract.Quantity * 100 : 0;

                        <TableRow Class="bg-gray-50 dark:bg-gray-800/50">
                            <TableCell colspan="6">
                                <div class="py-4">
                                    <!-- Delivery Progress at top -->
                                    <div class="mb-10">
                                        <p class="text-sm text-gray-500 dark:text-gray-400 mb-2">Delivery Progress</p>
                                        <!-- Custom progress bar: green for delivered, gray for remaining -->
                                        <div style="height: 16px; background-color: #e5e7eb; border-radius: 9999px; overflow: hidden; width: 100%;">
                                            <div style="height: 100%; background-color: #22c55e; width: @(progressPercent.ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;"></div>
                                        </div>
                                        <div class="flex justify-between text-xs text-gray-500 dark:text-gray-400 mt-2 mb-6">
                                            <span>@deliveryStats.DeliveredBushels.ToString("N0") delivered</span>
                                            <span>@deliveryStats.RemainingBushels.ToString("N0") remaining</span>
                                        </div>
                                    </div>

                                    <!-- Two column layout -->
                                    <div class="grid grid-cols-2 gap-8">
                                        <!-- Left column -->
                                        <div class="space-y-6">
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Contract Value</p>
                                                <p>$@((contract.Quantity * contract.Price).ToString("N2"))</p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Price per Bushel</p>
                                                <p>$@contract.Price.ToString("F2")</p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">End Date</p>
                                                <p>@contract.DeliveryEnd.ToString("M/d/yyyy")</p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Total Delivered</p>
                                                <p>@deliveryStats.DeliveredBushels.ToString("N0") @contract.Unit</p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Delivery Progress</p>
                                                <p>@(progressPercent.ToString("F0"))%</p>
                                            </div>
                                        </div>

                                        <!-- Right column -->
                                        <div class="space-y-6">
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Delivery Window</p>
                                                <p>
                                                    @if (DateTime.Now < contract.DeliveryStart)
                                                    {
                                                        <span>Not Started</span>
                                                    }
                                                    else if (DateTime.Now > contract.DeliveryEnd)
                                                    {
                                                        <span>Ended</span>
                                                    }
                                                    else
                                                    {
                                                        <span>Open</span>
                                                    }
                                                </p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Start Date</p>
                                                <p>@contract.DeliveryStart.ToString("M/d/yyyy")</p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Unit Type</p>
                                                <p>@contract.Unit</p>
                                            </div>
                                            <div>
                                                <p class="text-sm text-gray-500 dark:text-gray-400">Remaining Quantity</p>
                                                <p>@deliveryStats.RemainingBushels.ToString("N0") @contract.Unit</p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Applied Tickets Section -->
                                    @{
                                        var appliedTickets = GetAppliedTickets(contract);
                                    }
                                    <div class="mt-6 pt-6 border-t border-gray-200 dark:border-gray-700">
                                        <p class="text-sm mb-4">Applied Tickets (@appliedTickets.Count)</p>

                                        @if (appliedTickets.Any())
                                        {
                                            @foreach (var ticket in appliedTickets)
                                            {
                                                <div class="bg-white dark:bg-gray-800 rounded-lg p-4 border border-gray-200 dark:border-gray-700 mb-3">
                                                        <!-- Row 1 -->
                                                        <div class="grid grid-cols-3 gap-4 mb-4">
                                                            <div>
                                                                <p class="text-sm text-gray-500 dark:text-gray-400">Ticket ID</p>
                                                                <p>@ticket.Id</p>
                                                            </div>
                                                            <div>
                                                                <p class="text-sm text-gray-500 dark:text-gray-400">Date</p>
                                                                <p>@ticket.Date.ToString("M/d/yyyy")</p>
                                                            </div>
                                                            <div>
                                                                <p class="text-sm text-gray-500 dark:text-gray-400">Net Weight</p>
                                                                <p>@ticket.NetWeight.ToString("N0") lbs</p>
                                                            </div>
                                                        </div>
                                                        <!-- Row 2 -->
                                                        <div class="grid grid-cols-3 gap-4">
                                                            <div>
                                                                <p class="text-sm text-gray-500 dark:text-gray-400">Moisture</p>
                                                                <p>@ticket.Moisture.ToString("F1")%</p>
                                                            </div>
                                                            <div>
                                                                <p class="text-sm text-gray-500 dark:text-gray-400">Test Weight</p>
                                                                <p>@ticket.TestWeight.ToString("F1") lbs/bu</p>
                                                            </div>
                                                            <div>
                                                                <p class="text-sm text-gray-500 dark:text-gray-400">Crop</p>
                                                                <p>@ticket.Crop</p>
                                                            </div>
                                                        </div>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <p class="text-gray-500 dark:text-gray-400 text-sm">No tickets applied to this contract yet.</p>
                                        }
                                    </div>
                                </div>
                            </TableCell>
                        </TableRow>
                    }
                }
            </TableBody>
        </Table>
    }
</div>

@code {
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<Ticket> Tickets { get; set; } = new();

    private HashSet<string> expandedRows = new();
    private SortColumn? currentSortColumn;
    private SortDirection currentSortDirection = SortDirection.None;

    private enum SortColumn { ContractNumber, Crop, Quantity, Price, DeliveryStart, Status }
    private enum SortDirection { None, Ascending, Descending }

    private IEnumerable<Contract> sortedContracts
    {
        get
        {
            if (currentSortColumn == null || currentSortDirection == SortDirection.None)
                return Contracts;

            var sorted = currentSortColumn switch
            {
                SortColumn.ContractNumber => Contracts.OrderBy(c => c.ContractNumber),
                SortColumn.Crop => Contracts.OrderBy(c => c.Crop),
                SortColumn.Quantity => Contracts.OrderBy(c => c.Quantity),
                SortColumn.Price => Contracts.OrderBy(c => c.Price),
                SortColumn.DeliveryStart => Contracts.OrderBy(c => c.DeliveryStart),
                SortColumn.Status => Contracts.OrderBy(c => c.Status),
                _ => Contracts.AsEnumerable()
            };

            return currentSortDirection == SortDirection.Descending ? sorted.Reverse() : sorted;
        }
    }

    private void HandleSort(SortColumn column)
    {
        if (currentSortColumn == column)
        {
            currentSortDirection = currentSortDirection switch
            {
                SortDirection.None => SortDirection.Ascending,
                SortDirection.Ascending => SortDirection.Descending,
                SortDirection.Descending => SortDirection.None
            };

            if (currentSortDirection == SortDirection.None)
                currentSortColumn = null;
        }
        else
        {
            currentSortColumn = column;
            currentSortDirection = SortDirection.Ascending;
        }
    }

    private void ToggleRow(string id)
    {
        if (!expandedRows.Remove(id))
            expandedRows.Add(id);
    }

    private string GetStatusClass(ContractStatus status) => status switch
    {
        ContractStatus.Active => "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-green-600 text-white",
        ContractStatus.Fulfilled => "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-600 text-white",
        ContractStatus.Pending => "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-yellow-500 text-white",
        _ => "inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-500 text-white"
    };

    private (int DeliveredBushels, int RemainingBushels) CalculateDeliveryStats(Contract contract)
    {
        // For demo purposes, always show 50% delivered so the progress bar is visible
        var deliveredBushels = contract.Quantity / 2;
        var remaining = contract.Quantity - deliveredBushels;
        return (deliveredBushels, remaining);
    }

    private List<Ticket> GetAppliedTickets(Contract contract)
    {
        // Get tickets matching crop and farm within delivery period, ordered by ID ascending
        return Tickets
            .Where(t => t.Crop == contract.Crop &&
                        t.FarmId == contract.FarmId &&
                        t.Date >= contract.DeliveryStart &&
                        t.Date <= contract.DeliveryEnd)
            .OrderBy(t => t.Id)
            .ToList();
    }

    private RenderFragment SortIconFragment(SortColumn column) => builder =>
    {
        var iconName = "arrow-up-down";
        var iconClass = "text-gray-300 dark:text-gray-600";

        if (currentSortColumn == column)
        {
            iconClass = "text-gray-600 dark:text-gray-300";
            iconName = currentSortDirection == SortDirection.Ascending ? "arrow-up" : "arrow-down";
        }

        builder.OpenComponent<Icon>(0);
        builder.AddAttribute(1, "Name", iconName);
        builder.AddAttribute(2, "Size", 14);
        builder.AddAttribute(3, "Class", iconClass);
        builder.CloseComponent();
    };
}
