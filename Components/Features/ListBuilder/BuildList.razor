@namespace GrainOriginatorPortal.Components.Features.ListBuilder

<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
        <div>
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white">Build a List</h2>
            <p class="text-gray-500 dark:text-gray-400">Create targeted customer lists using natural language or filters</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Query Builder Panel -->
        <div class="lg:col-span-1 space-y-4">
            <Card>
                <CardHeader>
                    <CardTitle>
                        <Icon Name="search" Size="20" Class="inline-block mr-2" />
                        Query Builder
                    </CardTitle>
                    <CardDescription>
                        Type a natural language query or use the filters below
                    </CardDescription>
                </CardHeader>
                <CardContent Class="space-y-4">
                    <!-- Natural Language Input -->
                    <div class="space-y-2">
                        <Label>Natural Language Query</Label>
                        <Textarea Placeholder="e.g., Show me large corn producers in Iowa who haven't been contacted recently"
                                  Value="@queryText"
                                  ValueChanged="HandleQueryChange"
                                  Rows="3" />
                        <Button OnClick="ProcessQuery" Class="w-full" Disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <Icon Name="loader-2" Size="16" Class="mr-2 animate-spin" />
                                <span>Processing...</span>
                            }
                            else
                            {
                                <Icon Name="sparkles" Size="16" Class="mr-2" />
                                <span>Process Query</span>
                            }
                        </Button>
                    </div>

                    <Separator />

                    <!-- Advanced Filters Toggle -->
                    <Button Variant="ghost" OnClick="() => showAdvancedFilters = !showAdvancedFilters" Class="w-full justify-between">
                        <span>Advanced Filters</span>
                        @if (showAdvancedFilters)
                        {
                            <Icon Name="chevron-up" Size="16" />
                        }
                        else
                        {
                            <Icon Name="chevron-down" Size="16" />
                        }
                    </Button>

                    @if (showAdvancedFilters)
                    {
                        <div class="space-y-4 pt-2">
                            <!-- No Active Contracts -->
                            <div class="flex items-center justify-between">
                                <Label>No Active Contracts</Label>
                                <input type="checkbox"
                                       checked="@filterState.NoActiveContracts"
                                       @onchange="e => { filterState.NoActiveContracts = (bool)(e.Value ?? false); ApplyFilters(); }"
                                       class="h-4 w-4 rounded border-gray-300" />
                            </div>

                            <!-- Has Grain Available -->
                            <div class="flex items-center justify-between">
                                <Label>Has Grain Available</Label>
                                <input type="checkbox"
                                       checked="@filterState.HasGrainAvailable"
                                       @onchange="e => { filterState.HasGrainAvailable = (bool)(e.Value ?? false); ApplyFilters(); }"
                                       class="h-4 w-4 rounded border-gray-300" />
                            </div>

                            <!-- Not Contacted Recently -->
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <Label>Not Contacted Recently</Label>
                                    <input type="checkbox"
                                           checked="@filterState.NotContactedRecently"
                                           @onchange="e => { filterState.NotContactedRecently = (bool)(e.Value ?? false); ApplyFilters(); }"
                                           class="h-4 w-4 rounded border-gray-300" />
                                </div>
                                @if (filterState.NotContactedRecently)
                                {
                                    <div class="flex items-center gap-2">
                                        <Input Type="number"
                                               Value="@filterState.NotContactedDays.ToString()"
                                               ValueChanged="v => { filterState.NotContactedDays = int.TryParse(v, out var d) ? d : 60; ApplyFilters(); }"
                                               Class="w-20" />
                                        <span class="text-sm text-gray-500">days</span>
                                    </div>
                                }
                            </div>

                            <!-- Large Operations -->
                            <div class="space-y-2">
                                <div class="flex items-center justify-between">
                                    <Label>Large Operations Only</Label>
                                    <input type="checkbox"
                                           checked="@filterState.LargeOperations"
                                           @onchange="e => { filterState.LargeOperations = (bool)(e.Value ?? false); ApplyFilters(); }"
                                           class="h-4 w-4 rounded border-gray-300" />
                                </div>
                                @if (filterState.LargeOperations)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm text-gray-500">Top</span>
                                        <Input Type="number"
                                               Value="@filterState.TopN.ToString()"
                                               ValueChanged="v => { filterState.TopN = int.TryParse(v, out var n) ? n : 10; ApplyFilters(); }"
                                               Class="w-20" />
                                        <span class="text-sm text-gray-500">by acres</span>
                                    </div>
                                }
                            </div>

                            <!-- Crop Filter -->
                            <div class="space-y-2">
                                <Label>Filter by Crop</Label>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var crop in availableCrops)
                                    {
                                        var isSelected = filterState.Crops.Contains(crop);
                                        <Badge Class="@(isSelected ? "bg-green-500 text-white cursor-pointer" : "bg-gray-200 dark:bg-gray-700 cursor-pointer")"
                                               @onclick="() => ToggleCrop(crop)">
                                            @crop
                                        </Badge>
                                    }
                                </div>
                            </div>

                            <!-- Location Filter -->
                            <div class="space-y-2">
                                <Label>Filter by State</Label>
                                <div class="flex flex-wrap gap-2">
                                    @foreach (var state in availableStates)
                                    {
                                        var isSelected = filterState.Locations.Contains(state);
                                        <Badge Class="@(isSelected ? "bg-blue-500 text-white cursor-pointer" : "bg-gray-200 dark:bg-gray-700 cursor-pointer")"
                                               @onclick="() => ToggleState(state)">
                                            @state
                                        </Badge>
                                    }
                                </div>
                            </div>

                            <Button Variant="outline" OnClick="ClearFilters" Class="w-full">
                                <Icon Name="x" Size="16" Class="mr-2" />
                                Clear All Filters
                            </Button>
                        </div>
                    }
                </CardContent>
            </Card>

            <!-- Saved Lists -->
            <Card>
                <CardHeader>
                    <CardTitle>
                        <Icon Name="bookmark" Size="20" Class="inline-block mr-2" />
                        Saved Lists
                    </CardTitle>
                </CardHeader>
                <CardContent>
                    @if (!SavedLists.Any())
                    {
                        <p class="text-sm text-gray-500 dark:text-gray-400 text-center py-4">
                            No saved lists yet
                        </p>
                    }
                    else
                    {
                        <div class="space-y-2">
                            @foreach (var list in SavedLists)
                            {
                                <div class="flex items-center justify-between p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50">
                                    <button type="button"
                                            class="flex-1 text-left"
                                            @onclick="() => LoadSavedList(list)">
                                        <div class="font-medium text-gray-900 dark:text-white">@list.Name</div>
                                        <div class="text-xs text-gray-500">@list.CustomerIds.Count customers</div>
                                    </button>
                                    <Button Variant="ghost" Size="icon" OnClick="() => HandleDeleteList(list.Id)" Class="h-8 w-8 text-red-500 hover:text-red-700">
                                        <Icon Name="trash-2" Size="16" />
                                    </Button>
                                </div>
                            }
                        </div>
                    }
                </CardContent>
            </Card>
        </div>

        <!-- Results Panel -->
        <div class="lg:col-span-2">
            <Card>
                <CardHeader>
                    <div class="flex items-center justify-between">
                        <div>
                            <CardTitle>
                                Results
                                <Badge Variant="secondary" Class="ml-2">@filteredCustomers.Count</Badge>
                            </CardTitle>
                            <CardDescription>
                                @if (!string.IsNullOrEmpty(queryText))
                                {
                                    <span>Query: "@queryText"</span>
                                }
                                else
                                {
                                    <span>Showing all customers matching your filters</span>
                                }
                            </CardDescription>
                        </div>
                        @if (filteredCustomers.Any())
                        {
                            <div class="flex gap-2">
                                <Button Variant="outline" OnClick="() => showSaveDialog = true">
                                    <Icon Name="star" Size="16" Class="mr-2" />
                                    Save List
                                </Button>
                            </div>
                        }
                    </div>
                </CardHeader>
                <CardContent>
                    @if (!filteredCustomers.Any())
                    {
                        <div class="text-center py-12">
                            <Icon Name="users" Size="48" Class="mx-auto mb-4 text-gray-300 dark:text-gray-600" />
                            <h3 class="text-gray-500 dark:text-gray-400 mb-2">No Customers Found</h3>
                            <p class="text-sm text-gray-400 dark:text-gray-500">Try adjusting your filters or query</p>
                        </div>
                    }
                    else
                    {
                        <div class="divide-y divide-gray-200 dark:divide-gray-700">
                            @foreach (var customer in filteredCustomers)
                            {
                                var lastContact = GetLastContactInfo(customer.Id);

                                <div class="py-4 flex items-start justify-between hover:bg-gray-50 dark:hover:bg-gray-700/50 -mx-4 px-4 cursor-pointer transition-colors"
                                     @onclick="() => HandleSelectCustomer(customer)">
                                    <div class="flex items-start gap-3">
                                        <Avatar Fallback="@GetInitials(customer.Name)" Size="sm" />
                                        <div>
                                            <div class="font-medium text-gray-900 dark:text-white">
                                                @customer.Name
                                            </div>
                                            <div class="text-sm text-gray-500 dark:text-gray-400">
                                                @customer.Farm
                                            </div>
                                            <div class="flex items-center gap-2 mt-1">
                                                <Badge Variant="secondary">@customer.TotalAcres.ToString("N0") acres</Badge>
                                                <span class="text-xs text-gray-400">@customer.Location</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <span class="@GetLastContactClass(lastContact.DaysAgo) text-sm">
                                            @lastContact.Text
                                        </span>
                                        <div class="flex gap-1 mt-2">
                                            @foreach (var crop in GetCustomerCrops(customer.Id))
                                            {
                                                <Badge Variant="outline" Class="text-xs">@crop</Badge>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </CardContent>
            </Card>
        </div>
    </div>

    <!-- Save List Dialog -->
    <Dialog IsOpen="@showSaveDialog" IsOpenChanged="v => showSaveDialog = v">
        <DialogHeader>
            <DialogTitle>Save List</DialogTitle>
            <DialogDescription>Give this list a name so you can easily access it later</DialogDescription>
        </DialogHeader>
        <div class="space-y-4">
            <div class="space-y-2">
                <Label>List Name</Label>
                <Input Type="text"
                       Value="@newListName"
                       ValueChanged="v => newListName = v"
                       Placeholder="e.g., High Priority Prospects" />
            </div>
            <DialogFooter>
                <Button Variant="outline" OnClick="() => showSaveDialog = false">Cancel</Button>
                <Button OnClick="HandleSaveList" Disabled="@string.IsNullOrWhiteSpace(newListName)">
                    Save List
                </Button>
            </DialogFooter>
        </div>
    </Dialog>
</div>

@code {
    [Parameter] public List<Customer> Customers { get; set; } = new();
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public List<Note> Notes { get; set; } = new();
    [Parameter] public List<SavedList> SavedLists { get; set; } = new();
    [Parameter] public EventCallback<Customer> OnSelectCustomer { get; set; }
    [Parameter] public EventCallback<(string Name, string Query, List<string> CustomerIds)> OnSaveList { get; set; }
    [Parameter] public EventCallback<string> OnDeleteList { get; set; }

    private string queryText = "";
    private bool isProcessing = false;
    private bool showAdvancedFilters = false;
    private bool showSaveDialog = false;
    private string newListName = "";
    private List<Customer> filteredCustomers = new();

    private FilterState filterState = new();

    private class FilterState
    {
        public bool NoActiveContracts { get; set; }
        public bool HasGrainAvailable { get; set; }
        public bool NotContactedRecently { get; set; }
        public int NotContactedDays { get; set; } = 60;
        public bool LargeOperations { get; set; }
        public int TopN { get; set; } = 10;
        public List<string> Crops { get; set; } = new();
        public List<string> Locations { get; set; } = new();
    }

    private List<string> availableCrops => PlantingIntentions
        .Select(p => p.Crop)
        .Distinct()
        .OrderBy(c => c)
        .ToList();

    private List<string> availableStates => Customers
        .Select(c => ExtractState(c.Location))
        .Where(s => !string.IsNullOrEmpty(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    protected override void OnInitialized()
    {
        filteredCustomers = Customers.ToList();
    }

    private void HandleQueryChange(string query)
    {
        queryText = query;
    }

    private async Task ProcessQuery()
    {
        isProcessing = true;
        StateHasChanged();

        // Simulate processing delay
        await Task.Delay(800);

        // Parse natural language query
        ParseNaturalLanguageQuery(queryText);
        ApplyFilters();

        isProcessing = false;
        StateHasChanged();
    }

    private void ParseNaturalLanguageQuery(string query)
    {
        var lowerQuery = query.ToLower();

        // Reset filters first
        filterState = new FilterState();

        // Check for "no active contract" patterns
        if (lowerQuery.Contains("no active contract") || lowerQuery.Contains("no contract") || lowerQuery.Contains("without contract"))
        {
            filterState.NoActiveContracts = true;
        }

        // Check for "grain available" patterns
        if (lowerQuery.Contains("grain available") || lowerQuery.Contains("has grain") || lowerQuery.Contains("stored grain"))
        {
            filterState.HasGrainAvailable = true;
        }

        // Check for "not contacted" patterns
        if (lowerQuery.Contains("not contacted") || lowerQuery.Contains("haven't contacted") || lowerQuery.Contains("no contact"))
        {
            filterState.NotContactedRecently = true;

            // Try to extract days
            var match = System.Text.RegularExpressions.Regex.Match(lowerQuery, @"(\d+)\s*days?");
            if (match.Success && int.TryParse(match.Groups[1].Value, out var days))
            {
                filterState.NotContactedDays = days;
            }
        }

        // Check for "large" or "biggest" patterns
        if (lowerQuery.Contains("large") || lowerQuery.Contains("biggest") || lowerQuery.Contains("top"))
        {
            filterState.LargeOperations = true;

            var match = System.Text.RegularExpressions.Regex.Match(lowerQuery, @"top\s*(\d+)");
            if (match.Success && int.TryParse(match.Groups[1].Value, out var n))
            {
                filterState.TopN = n;
            }
        }

        // Check for crop names
        foreach (var crop in availableCrops)
        {
            if (lowerQuery.Contains(crop.ToLower()))
            {
                filterState.Crops.Add(crop);
            }
        }

        // Check for state names
        foreach (var state in availableStates)
        {
            if (lowerQuery.Contains(state.ToLower()))
            {
                filterState.Locations.Add(state);
            }
        }

        showAdvancedFilters = true;
    }

    private void ApplyFilters()
    {
        var result = Customers.AsEnumerable();

        // No active contracts filter
        if (filterState.NoActiveContracts)
        {
            var customersWithActiveContracts = Contracts
                .Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Pending)
                .Select(c => c.CustomerId)
                .Distinct()
                .ToHashSet();

            result = result.Where(c => !customersWithActiveContracts.Contains(c.Id));
        }

        // Has grain available filter
        if (filterState.HasGrainAvailable)
        {
            var customersWithPlanting = PlantingIntentions
                .Select(p => p.CustomerId)
                .Distinct()
                .ToHashSet();

            result = result.Where(c => customersWithPlanting.Contains(c.Id));
        }

        // Not contacted recently filter
        if (filterState.NotContactedRecently)
        {
            var cutoffDate = DateTime.Now.AddDays(-filterState.NotContactedDays);

            result = result.Where(c =>
            {
                var lastNote = Notes
                    .Where(n => n.CustomerId == c.Id)
                    .OrderByDescending(n => n.Timestamp)
                    .FirstOrDefault();

                return lastNote == null || lastNote.Timestamp < cutoffDate;
            });
        }

        // Crop filter
        if (filterState.Crops.Any())
        {
            var customersWithCrops = PlantingIntentions
                .Where(p => filterState.Crops.Contains(p.Crop))
                .Select(p => p.CustomerId)
                .Distinct()
                .ToHashSet();

            result = result.Where(c => customersWithCrops.Contains(c.Id));
        }

        // Location filter
        if (filterState.Locations.Any())
        {
            result = result.Where(c =>
                filterState.Locations.Any(state =>
                    c.Location.Contains(state, StringComparison.OrdinalIgnoreCase)));
        }

        // Large operations filter (apply last as it limits results)
        if (filterState.LargeOperations)
        {
            result = result.OrderByDescending(c => c.TotalAcres).Take(filterState.TopN);
        }

        filteredCustomers = result.ToList();
    }

    private void ToggleCrop(string crop)
    {
        if (!filterState.Crops.Remove(crop))
            filterState.Crops.Add(crop);
        ApplyFilters();
    }

    private void ToggleState(string state)
    {
        if (!filterState.Locations.Remove(state))
            filterState.Locations.Add(state);
        ApplyFilters();
    }

    private void ClearFilters()
    {
        filterState = new FilterState();
        queryText = "";
        filteredCustomers = Customers.ToList();
    }

    private void LoadSavedList(SavedList list)
    {
        queryText = list.Query;
        filteredCustomers = Customers.Where(c => list.CustomerIds.Contains(c.Id)).ToList();
    }

    private async Task HandleSaveList()
    {
        if (!string.IsNullOrWhiteSpace(newListName) && filteredCustomers.Any())
        {
            var customerIds = filteredCustomers.Select(c => c.Id).ToList();
            await OnSaveList.InvokeAsync((newListName, queryText, customerIds));
            newListName = "";
            showSaveDialog = false;
        }
    }

    private async Task HandleDeleteList(string listId)
    {
        await OnDeleteList.InvokeAsync(listId);
    }

    private async Task HandleSelectCustomer(Customer customer)
    {
        await OnSelectCustomer.InvokeAsync(customer);
    }

    private string ExtractState(string location)
    {
        // Extract state abbreviation from location like "Iowa County, IA"
        var parts = location.Split(',');
        if (parts.Length > 1)
        {
            return parts.Last().Trim();
        }
        return "";
    }

    private string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        if (parts.Length == 1 && parts[0].Length >= 2)
            return parts[0].Substring(0, 2).ToUpper();
        return "??";
    }

    private (string Text, int DaysAgo) GetLastContactInfo(string customerId)
    {
        var lastNote = Notes
            .Where(n => n.CustomerId == customerId)
            .OrderByDescending(n => n.Timestamp)
            .FirstOrDefault();

        if (lastNote == null)
            return ("No contact", -1);

        var daysAgo = (int)(DateTime.Now - lastNote.Timestamp).TotalDays;

        if (daysAgo == 0) return ("Today", 0);
        if (daysAgo == 1) return ("Yesterday", 1);
        if (daysAgo < 7) return ($"{daysAgo} days ago", daysAgo);
        if (daysAgo < 30) return ($"{daysAgo / 7} weeks ago", daysAgo);
        return ($"{daysAgo / 30} months ago", daysAgo);
    }

    private string GetLastContactClass(int daysAgo)
    {
        if (daysAgo < 0) return "text-red-500";
        if (daysAgo <= 7) return "text-green-500";
        if (daysAgo <= 30) return "text-yellow-500";
        return "text-red-500";
    }

    private IEnumerable<string> GetCustomerCrops(string customerId)
    {
        return PlantingIntentions
            .Where(p => p.CustomerId == customerId)
            .Select(p => p.Crop)
            .Distinct()
            .Take(3);
    }
}
