@namespace GrainOriginatorPortal.Components.Features.Insights

<div class="rounded-xl overflow-hidden" style="@GradientStyle">
    <div class="p-6 pb-8">
        <!-- Header Row -->
        <div class="flex items-start justify-between mb-2">
            <div class="flex items-center gap-3">
                <Icon Name="sparkles" Size="24" Class="text-white" />
                <h3 class="text-xl font-semibold text-white">Producer Insights</h3>
            </div>
            @if (Customer.ESignEnabled)
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium" style="@BadgeStyle">
                    <Icon Name="check-circle" Size="14" />
                    eSign Enabled
                </span>
            }
            else
            {
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium" style="@BadgeNotEnrolledStyle">
                    <Icon Name="x-circle" Size="14" />
                    eSign Not Enrolled
                </span>
            }
        </div>

        <!-- Subtitle -->
        <p style="@SubtitleStyle">
            @Customer.Name - Performance Analytics & Growth Metrics
        </p>

        <!-- Spacer -->
        <div class="h-8"></div>

        <!-- Stats Grid - Single Row of 4 -->
        <div class="grid grid-cols-4 gap-4">
            <!-- Total Volume -->
            <div class="rounded-xl p-4" style="@CardStyle">
                <div class="flex items-center justify-between mb-3">
                    <span style="@LabelStyle">Total Volume</span>
                    <Icon Name="box" Size="18" Style="@IconStyle" />
                </div>
                <div class="text-2xl text-white mb-1">
                    @totalContracted.ToString("N0")
                </div>
                <div style="@SublabelStyle">bushels contracted</div>
            </div>

            <!-- Total Revenue -->
            <div class="rounded-xl p-4" style="@CardStyle">
                <div class="flex items-center justify-between mb-3">
                    <span style="@LabelStyle">Total Revenue</span>
                    <Icon Name="dollar-sign" Size="18" Style="@IconStyle" />
                </div>
                <div class="text-2xl text-white mb-1">
                    $@FormatRevenue(totalRevenue)
                </div>
                <div style="@SublabelStyle">@activeContractCount contracts</div>
            </div>

            <!-- YOY Growth -->
            <div class="rounded-xl p-4" style="@CardStyle">
                <div class="flex items-center justify-between mb-3">
                    <span style="@LabelStyle">YOY Growth</span>
                    <Icon Name="trending-up" Size="18" Style="@IconStyle" />
                </div>
                <div class="text-2xl text-white mb-1">
                    @(yoyGrowth >= 0 ? "+" : "")@yoyGrowth.ToString("F1")%
                </div>
                <div style="@SublabelStyle">vs. previous year</div>
            </div>

            <!-- Engagement -->
            <div class="rounded-xl p-4" style="@CardStyle">
                <div class="flex items-center justify-between mb-3">
                    <span style="@LabelStyle">Engagement</span>
                    <Icon Name="activity" Size="18" Style="@IconStyle" />
                </div>
                <div class="text-2xl text-white mb-1">
                    @totalInteractions
                </div>
                <div style="@SublabelStyle">total interactions</div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Customer Customer { get; set; } = default!;
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<Ticket> Tickets { get; set; } = new();
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public List<Note> Notes { get; set; } = new();
    [Parameter] public List<StoredGrain> StoredGrain { get; set; } = new();
    [Parameter] public bool IsDarkMode { get; set; }

    // Main gradient - darker in dark mode
    private string GradientStyle => IsDarkMode
        ? "background: linear-gradient(145deg, #166534 0%, #15803d 20%, #14532d 50%, #052e16 100%);"
        : "background: linear-gradient(145deg, #22c55e 0%, #16a34a 35%, #15803d 65%, #166534 100%);";

    // Subtitle color
    private string SubtitleStyle => IsDarkMode
        ? "color: #86efac; font-size: 0.875rem;"
        : "color: #bbf7d0; font-size: 0.875rem;";

    // Card styling
    private string CardStyle => IsDarkMode
        ? "background: rgba(21, 128, 61, 0.3); border: 1px solid rgba(34, 197, 94, 0.4);"
        : "background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(134, 239, 172, 0.3);";

    // Labels inside cards
    private string LabelStyle => IsDarkMode
        ? "color: #86efac; font-size: 0.875rem;"
        : "color: #bbf7d0; font-size: 0.875rem;";

    // Icons inside cards
    private string IconStyle => IsDarkMode
        ? "color: #4ade80;"
        : "color: #86efac;";

    // Sublabels (bushels contracted, etc.)
    private string SublabelStyle => IsDarkMode
        ? "color: #86efac; font-size: 0.75rem;"
        : "color: #86efac; font-size: 0.75rem;";

    // eSign Enabled badge
    private string BadgeStyle => IsDarkMode
        ? "background: rgba(34, 197, 94, 0.2); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.4);"
        : "background: rgba(255, 255, 255, 0.15); color: white; border: 1px solid rgba(255, 255, 255, 0.3);";

    // eSign Not Enrolled badge
    private string BadgeNotEnrolledStyle => IsDarkMode
        ? "background: rgba(75, 85, 99, 0.5); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.5);"
        : "background: rgba(255, 255, 255, 0.15); color: rgba(255, 255, 255, 0.7); border: 1px solid rgba(255, 255, 255, 0.2);";

    private int totalContracted => Contracts
        .Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Pending)
        .Sum(c => c.Quantity);

    private decimal totalRevenue => Contracts
        .Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Fulfilled)
        .Sum(c => c.Quantity * c.Price);

    private int activeContractCount => Contracts
        .Count(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Pending);

    private double yoyGrowth => 0.0;

    private int totalInteractions => Notes.Count + Tickets.Count;

    private string FormatRevenue(decimal amount)
    {
        if (amount >= 1000000)
            return $"{(amount / 1000000):F1}M";
        if (amount >= 1000)
            return $"{(amount / 1000):F0}K";
        return amount.ToString("N0");
    }
}
