@namespace GrainOriginatorPortal.Components.Features.Insights

<Card Class="overflow-hidden border-green-200 dark:border-green-800">
    <div class="bg-green-50 dark:bg-green-900/20 p-6">
        <div class="flex items-center gap-2 mb-4">
            <Icon Name="sparkles" Size="20" Class="text-green-600 dark:text-green-400" />
            <h3 class="font-semibold text-lg text-green-600 dark:text-green-400">Summary</h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">
            @GenerateSummaryParagraph()
        </p>
    </div>
</Card>

@code {
    [Parameter, EditorRequired] public Customer Customer { get; set; } = default!;
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<Ticket> Tickets { get; set; } = new();
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public List<Note> Notes { get; set; } = new();
    [Parameter] public List<StoredGrain> StoredGrain { get; set; } = new();

    private string GenerateSummaryParagraph()
    {
        var sentences = new List<string>();

        // Market share insight
        var totalProjected = PlantingIntentions.Sum(p => p.Acres * p.EstimatedYield);
        var totalContracted = Contracts
            .Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Pending)
            .Sum(c => c.Quantity);

        if (totalProjected > 0)
        {
            var marketShare = (double)totalContracted / totalProjected * 100;
            sentences.Add($"Currently capturing {marketShare:F0}% of projected {totalProjected:N0} bushel yield.");
        }

        // Planting overview
        if (PlantingIntentions.Any())
        {
            var crops = PlantingIntentions.GroupBy(p => p.Crop)
                .Select(g => $"{g.Sum(p => p.Acres):N0} acres of {g.Key}")
                .ToList();
            sentences.Add($"Planning to plant {string.Join(", ", crops)} this season.");
        }

        // Storage situation
        if (StoredGrain.Any())
        {
            var totalStored = StoredGrain.Sum(s => s.Quantity);
            var avgDays = StoredGrain.Average(s => (DateTime.Now - s.StorageStartDate).Days);
            sentences.Add($"Currently storing {totalStored:N0} bushels (avg {avgDays:F0} days in storage).");
        }

        // Recent contact
        var lastNote = Notes.OrderByDescending(n => n.Timestamp).FirstOrDefault();
        if (lastNote != null)
        {
            var daysSince = (DateTime.Now - lastNote.Timestamp).Days;
            if (daysSince == 0)
                sentences.Add($"Last contacted today by {lastNote.OriginatorName}.");
            else if (daysSince == 1)
                sentences.Add($"Last contacted yesterday by {lastNote.OriginatorName}.");
            else
                sentences.Add($"Last contacted {daysSince} days ago by {lastNote.OriginatorName}.");
        }
        else
        {
            sentences.Add("No contact history recorded yet.");
        }

        // Delivery activity
        var recentTickets = Tickets.Where(t => t.Date >= DateTime.Now.AddDays(-30)).ToList();
        if (recentTickets.Any())
        {
            var totalDelivered = recentTickets.Sum(t => t.NetWeight);
            sentences.Add($"Delivered {totalDelivered:N0} lbs in the last 30 days across {recentTickets.Count} tickets.");
        }

        // Upcoming actions
        var upcomingDeliveries = Contracts
            .Where(c => c.Status == ContractStatus.Active && c.DeliveryEnd >= DateTime.Now)
            .OrderBy(c => c.DeliveryEnd)
            .FirstOrDefault();

        if (upcomingDeliveries != null)
        {
            var daysRemaining = (upcomingDeliveries.DeliveryEnd - DateTime.Now).Days;
            sentences.Add($"Next delivery deadline: {upcomingDeliveries.Crop} contract ends in {daysRemaining} days.");
        }

        return string.Join(" ", sentences);
    }
}
