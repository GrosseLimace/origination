@namespace GrainOriginatorPortal.Components.Features.Insights

<div class="space-y-6">
    <!-- Summary Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <Card Class="p-4">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-green-100 dark:bg-green-900/30 rounded-lg">
                    <Icon Name="users" Size="24" Class="text-green-600 dark:text-green-400" />
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">@Customers.Count</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">Total Customers</div>
                </div>
            </div>
        </Card>
        <Card Class="p-4">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
                    <Icon Name="file-text" Size="24" Class="text-blue-600 dark:text-blue-400" />
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">@activeContracts</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">Active Contracts</div>
                </div>
            </div>
        </Card>
        <Card Class="p-4">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-amber-100 dark:bg-amber-900/30 rounded-lg">
                    <Icon Name="wheat" Size="24" Class="text-amber-600 dark:text-amber-400" />
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">@totalAcres.ToString("N0")</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">Total Acres</div>
                </div>
            </div>
        </Card>
        <Card Class="p-4">
            <div class="flex items-center gap-3">
                <div class="p-2 bg-purple-100 dark:bg-purple-900/30 rounded-lg">
                    <Icon Name="dollar-sign" Size="24" Class="text-purple-600 dark:text-purple-400" />
                </div>
                <div>
                    <div class="text-2xl font-bold text-gray-900 dark:text-white">$@totalContractValue.ToString("N0")</div>
                    <div class="text-sm text-gray-500 dark:text-gray-400">Contract Value</div>
                </div>
            </div>
        </Card>
    </div>

    <!-- Charts Row -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Contract Status Distribution -->
        <Card>
            <CardHeader>
                <CardTitle>Contract Status Distribution</CardTitle>
                <CardDescription>All contracts across your territory</CardDescription>
            </CardHeader>
            <CardContent>
                @if (contractStatusData.Any())
                {
                    <ApexChart TItem="ChartDataItem"
                               Title=""
                               Options="@pieChartOptions">
                        <ApexPointSeries TItem="ChartDataItem"
                                         Items="@contractStatusData"
                                         SeriesType="SeriesType.Donut"
                                         XValue="@(e => e.Label)"
                                         YValue="@(e => e.Value)"
                                         OrderBy="e => e.X" />
                    </ApexChart>
                }
            </CardContent>
        </Card>

        <!-- Crop Distribution -->
        <Card>
            <CardHeader>
                <CardTitle>Crop Distribution</CardTitle>
                <CardDescription>Acres by crop type</CardDescription>
            </CardHeader>
            <CardContent>
                @if (cropDistributionData.Any())
                {
                    <ApexChart TItem="ChartDataItem"
                               Title=""
                               Options="@barChartOptions">
                        <ApexPointSeries TItem="ChartDataItem"
                                         Items="@cropDistributionData"
                                         SeriesType="SeriesType.Bar"
                                         XValue="@(e => e.Label)"
                                         YValue="@(e => e.Value)"
                                         OrderBy="e => e.X" />
                    </ApexChart>
                }
            </CardContent>
        </Card>
    </div>

    <!-- Top Customers Table -->
    <Card>
        <CardHeader>
            <CardTitle>Top Customers by Acreage</CardTitle>
            <CardDescription>Your largest operations</CardDescription>
        </CardHeader>
        <CardContent>
            <Table>
                <TableHeader>
                    <TableRow>
                        <TableHead>Customer</TableHead>
                        <TableHead>Location</TableHead>
                        <TableHead>Acres</TableHead>
                        <TableHead>Active Contracts</TableHead>
                        <TableHead>Contract Value</TableHead>
                    </TableRow>
                </TableHeader>
                <TableBody>
                    @foreach (var customer in topCustomers)
                    {
                        var customerContracts = Contracts.Where(c => c.CustomerId == customer.Id).ToList();
                        var activeCount = customerContracts.Count(c => c.Status == ContractStatus.Active);
                        var totalValue = customerContracts.Sum(c => c.Quantity * c.Price);

                        <TableRow>
                            <TableCell Class="font-medium">@customer.Name</TableCell>
                            <TableCell>@customer.Location</TableCell>
                            <TableCell>@customer.TotalAcres.ToString("N0")</TableCell>
                            <TableCell>@activeCount</TableCell>
                            <TableCell>$@totalValue.ToString("N0")</TableCell>
                        </TableRow>
                    }
                </TableBody>
            </Table>
        </CardContent>
    </Card>
</div>

@code {
    [Parameter] public List<Customer> Customers { get; set; } = new();
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public bool IsDarkMode { get; set; }

    private class ChartDataItem
    {
        public string Label { get; set; } = "";
        public decimal Value { get; set; }
        public int X { get; set; }
    }

    private List<ChartDataItem> contractStatusData = new();
    private List<ChartDataItem> cropDistributionData = new();
    private ApexChartOptions<ChartDataItem> pieChartOptions = new();
    private ApexChartOptions<ChartDataItem> barChartOptions = new();

    private int activeContracts => Contracts.Count(c => c.Status == ContractStatus.Active);
    private int totalAcres => Customers.Sum(c => c.TotalAcres);
    private decimal totalContractValue => Contracts.Sum(c => c.Quantity * c.Price);
    private IEnumerable<Customer> topCustomers => Customers.OrderByDescending(c => c.TotalAcres).Take(5);

    protected override void OnInitialized()
    {
        LoadChartData();
        ConfigureChartOptions();
    }

    protected override void OnParametersSet()
    {
        LoadChartData();
        ConfigureChartOptions();
    }

    private void LoadChartData()
    {
        // Contract Status Data
        contractStatusData = Contracts
            .GroupBy(c => c.Status)
            .Select((g, i) => new ChartDataItem
            {
                Label = g.Key.ToString(),
                Value = g.Count(),
                X = i
            })
            .ToList();

        // Crop Distribution Data
        cropDistributionData = PlantingIntentions
            .GroupBy(p => p.Crop)
            .Select((g, i) => new ChartDataItem
            {
                Label = g.Key,
                Value = g.Sum(p => p.Acres),
                X = i
            })
            .OrderByDescending(c => c.Value)
            .ToList();
    }

    private void ConfigureChartOptions()
    {
        var foregroundColor = IsDarkMode ? "#f5f5f5" : "#171717";
        var gridColor = IsDarkMode ? "#374151" : "#e5e7eb";

        pieChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = foregroundColor
            },
            Colors = new List<string> { "#22c55e", "#3b82f6", "#f59e0b" },
            Legend = new Legend
            {
                Position = LegendPosition.Bottom,
                Labels = new LegendLabels
                {
                    Colors = new Color(foregroundColor)
                }
            },
            Stroke = new Stroke { Show = false },
            PlotOptions = new PlotOptions
            {
                Pie = new PlotOptionsPie
                {
                    Donut = new PlotOptionsDonut
                    {
                        Size = "70%"
                    }
                }
            }
        };

        barChartOptions = new ApexChartOptions<ChartDataItem>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = foregroundColor,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = new List<string> { "#22c55e", "#3b82f6", "#f59e0b", "#ef4444" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 4,
                    Horizontal = true,
                    Distributed = true
                }
            },
            Legend = new Legend { Show = false },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle { Colors = new Color(foregroundColor) }
                }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle { Colors = new Color(foregroundColor) }
                    }
                }
            },
            Grid = new Grid { BorderColor = gridColor }
        };
    }
}
