@namespace GrainOriginatorPortal.Components.Features.Insights

<div class="rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden bg-white dark:bg-gray-800">
    <!-- Header -->
    <div class="p-5 border-b border-gray-200 dark:border-gray-700">
        <div class="flex items-center gap-2 mb-1">
            <Icon Name="trending-up" Size="20" Style="color: #3b82f6;" />
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Year-over-Year Performance</h3>
        </div>
        <p class="text-sm text-gray-500 dark:text-gray-400">Contract volume and revenue trends over time</p>
    </div>

    <!-- Chart -->
    <div class="p-6">
        <ApexChart TItem="YearData"
                   Title=""
                   Options="@chartOptions"
                   Height="300">
            <ApexPointSeries TItem="YearData"
                             Items="@chartData"
                             SeriesType="SeriesType.Bar"
                             Name="Volume (bu)"
                             XValue="@(e => e.Year)"
                             YValue="@(e => e.Volume)" />
            <ApexPointSeries TItem="YearData"
                             Items="@chartData"
                             SeriesType="SeriesType.Bar"
                             Name="Revenue ($)"
                             XValue="@(e => e.Year)"
                             YValue="@(e => e.Revenue)" />
        </ApexChart>
    </div>
</div>

@code {
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public bool IsDarkMode { get; set; }

    private List<YearData> chartData = new();
    private ApexChartOptions<YearData> chartOptions = new();

    public class YearData
    {
        public string Year { get; set; } = "";
        public decimal Volume { get; set; }
        public decimal Revenue { get; set; }
    }

    protected override void OnInitialized()
    {
        LoadChartData();
        ConfigureChartOptions();
    }

    protected override void OnParametersSet()
    {
        LoadChartData();
        ConfigureChartOptions();
    }

    private void LoadChartData()
    {
        // Group contracts by year and calculate totals
        var grouped = Contracts
            .GroupBy(c => c.DeliveryStart.Year)
            .Select(g => new YearData
            {
                Year = g.Key.ToString(),
                Volume = g.Sum(c => c.Quantity),
                Revenue = g.Sum(c => c.Quantity * c.Price)
            })
            .OrderBy(d => d.Year)
            .ToList();

        // If no data, show current year with zeros
        if (!grouped.Any())
        {
            grouped.Add(new YearData
            {
                Year = DateTime.Now.Year.ToString(),
                Volume = 0,
                Revenue = 0
            });
        }

        chartData = grouped;
    }

    private void ConfigureChartOptions()
    {
        var foregroundColor = IsDarkMode ? "#f5f5f5" : "#171717";
        var gridColor = IsDarkMode ? "#374151" : "#e5e7eb";

        chartOptions = new ApexChartOptions<YearData>
        {
            Chart = new Chart
            {
                Background = "transparent",
                ForeColor = foregroundColor,
                Toolbar = new Toolbar { Show = false }
            },
            Colors = new List<string> { "#22c55e", "#3b82f6" },
            PlotOptions = new PlotOptions
            {
                Bar = new PlotOptionsBar
                {
                    BorderRadius = 4,
                    ColumnWidth = "60%"
                }
            },
            Fill = new Fill
            {
                Type = new List<FillType> { FillType.Gradient, FillType.Gradient },
                Gradient = new FillGradient
                {
                    Type = GradientType.Vertical,
                    ShadeIntensity = 1,
                    OpacityFrom = 1,
                    OpacityTo = 0.7,
                    Stops = new List<double> { 0, 100 }
                }
            },
            Xaxis = new XAxis
            {
                Labels = new XAxisLabels
                {
                    Style = new AxisLabelStyle
                    {
                        Colors = new Color(foregroundColor),
                        FontSize = "12px"
                    }
                },
                AxisBorder = new AxisBorder { Show = false },
                AxisTicks = new AxisTicks { Show = false }
            },
            Yaxis = new List<YAxis>
            {
                new YAxis
                {
                    Title = new AxisTitle { Text = "" },
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle
                        {
                            Colors = new Color("#22c55e"),
                            FontSize = "11px"
                        },
                        Formatter = "function(val) { return val.toLocaleString(); }"
                    }
                },
                new YAxis
                {
                    Opposite = true,
                    Title = new AxisTitle { Text = "" },
                    Labels = new YAxisLabels
                    {
                        Style = new AxisLabelStyle
                        {
                            Colors = new Color("#3b82f6"),
                            FontSize = "11px"
                        },
                        Formatter = "function(val) { return val.toLocaleString(); }"
                    }
                }
            },
            Grid = new Grid
            {
                BorderColor = gridColor,
                StrokeDashArray = 4
            },
            Legend = new Legend
            {
                Position = LegendPosition.Bottom,
                HorizontalAlign = Align.Center,
                Labels = new LegendLabels
                {
                    Colors = new Color(foregroundColor)
                },
                Markers = new LegendMarkers
                {
                    Radius = 12
                }
            },
            Tooltip = new Tooltip
            {
                Theme = IsDarkMode ? Mode.Dark : Mode.Light,
                Y = new TooltipY
                {
                    Formatter = "function(val) { return val.toLocaleString(); }"
                }
            },
            DataLabels = new DataLabels
            {
                Enabled = false
            }
        };
    }
}
