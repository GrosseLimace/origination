@namespace GrainOriginatorPortal.Components.Features.Insights

<div class="rounded-xl border overflow-hidden" style="@ContainerStyle">
    <!-- Header with gradient background -->
    <div class="p-5" style="@HeaderStyle">
        <div class="flex items-start justify-between">
            <div class="flex items-start gap-3">
                <div class="p-2 rounded-lg" style="@IconBgStyle">
                    <Icon Name="sparkles" Size="24" Style="@IconStyle" />
                </div>
                <div>
                    <h3 class="text-lg font-semibold" style="@TitleStyle">AI Growth Forecast</h3>
                    <p class="text-sm" style="@SubtitleStyle">Revenue opportunity analysis and strategic recommendations</p>
                </div>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-sm font-medium" style="@BadgeStyle">
                <Icon Name="alert-triangle" Size="14" Style="@BadgeIconStyle" />
                @statusLabel
            </span>
        </div>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-6" style="@BodyStyle">
        <!-- Market Analysis Section -->
        <div>
            <div class="flex items-center gap-2 mb-4">
                <Icon Name="trending-up" Size="20" Style="color: #2563eb;" />
                <h4 class="font-semibold" style="@SectionTitleStyle">Market Analysis</h4>
            </div>
            <div>
                @foreach (var item in marketAnalysisItems)
                {
                    <div class="flex items-start gap-3 p-3 rounded-lg" style="@MarketItemStyle">
                        <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0 bg-blue-500"></div>
                        <p class="text-sm" style="@ItemTextStyle">@item</p>
                    </div>
                }
            </div>
        </div>

        <!-- Action Items Section -->
        <div>
            <div class="flex items-center gap-2 mb-4">
                <Icon Name="target" Size="20" Style="color: #16a34a;" />
                <h4 class="font-semibold" style="@SectionTitleStyle">Action Items</h4>
            </div>
            <div>
                @foreach (var item in actionItems)
                {
                    <div class="flex items-start gap-3 p-3 rounded-lg" style="@ActionItemStyle">
                        <div class="w-2 h-2 rounded-full mt-1.5 flex-shrink-0 bg-green-500"></div>
                        <p class="text-sm" style="@ItemTextStyle">@item</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Customer Customer { get; set; } = default!;
    [Parameter] public List<Contract> Contracts { get; set; } = new();
    [Parameter] public List<PlantingIntention> PlantingIntentions { get; set; } = new();
    [Parameter] public List<Note> Notes { get; set; } = new();
    [Parameter] public bool IsDarkMode { get; set; }

    // Container styling
    private string ContainerStyle => IsDarkMode
        ? "background: #1f2937; border-color: #374151;"
        : "background: white; border-color: #e5e7eb;";

    // Header gradient - Light: yellow, Dark: dark amber/brown
    private string HeaderStyle => IsDarkMode
        ? "background: linear-gradient(145deg, #451a03 0%, #371707 50%, #1c0a00 100%); border-bottom: 1px solid #78350f;"
        : "background: #fefce8;";

    // Body background
    private string BodyStyle => IsDarkMode
        ? "background: #1f2937;"
        : "background: white;";

    // Icon background
    private string IconBgStyle => IsDarkMode
        ? "background: rgba(251, 191, 36, 0.2);"
        : "background: rgba(251, 191, 36, 0.3);";

    // Icon color
    private string IconStyle => IsDarkMode
        ? "color: #fbbf24;"
        : "color: #d97706;";

    // Title color
    private string TitleStyle => IsDarkMode
        ? "color: #fde68a;"
        : "color: #111827;";

    // Subtitle color
    private string SubtitleStyle => IsDarkMode
        ? "color: #fbbf24;"
        : "color: #6b7280;";

    // Badge styling
    private string BadgeStyle => IsDarkMode
        ? "background: rgba(251, 191, 36, 0.15); color: #fcd34d; border: 1px solid rgba(251, 191, 36, 0.3);"
        : "background: #fef3c7; color: #d97706; border: 1px solid #fcd34d;";

    private string BadgeIconStyle => IsDarkMode
        ? "color: #fcd34d;"
        : "color: #d97706;";

    // Section title
    private string SectionTitleStyle => IsDarkMode
        ? "color: white;"
        : "color: #111827;";

    // Market Analysis item - Blue
    private string MarketItemStyle => IsDarkMode
        ? "background: rgba(30, 58, 138, 0.3); border-left: 4px solid #60a5fa; margin-bottom: 16px;"
        : "background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%); border-left: 4px solid #3b82f6; margin-bottom: 16px;";

    // Action item - Green
    private string ActionItemStyle => IsDarkMode
        ? "background: rgba(20, 83, 45, 0.3); border-left: 4px solid #4ade80; margin-bottom: 16px;"
        : "background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%); border-left: 4px solid #22c55e; margin-bottom: 16px;";

    // Item text
    private string ItemTextStyle => IsDarkMode
        ? "color: #e5e7eb;"
        : "color: #374151;";

    private string statusLabel => GetStatusLabel();
    private List<string> marketAnalysisItems => GenerateMarketAnalysis();
    private List<string> actionItems => GenerateActionItems();

    private string GetStatusLabel()
    {
        var daysSinceContact = GetDaysSinceLastContact();
        if (daysSinceContact > 90) return "Needs Attention";
        if (daysSinceContact > 30) return "Monitor";
        return "On Track";
    }

    private int GetDaysSinceLastContact()
    {
        var lastNote = Notes.OrderByDescending(n => n.Timestamp).FirstOrDefault();
        if (lastNote == null) return 999;
        return (int)(DateTime.Now - lastNote.Timestamp).TotalDays;
    }

    private List<string> GenerateMarketAnalysis()
    {
        var items = new List<string>();

        // Volume analysis
        items.Add("Contract volumes have remained relatively stable year-over-year.");

        // Market share analysis
        var totalProjected = PlantingIntentions.Sum(p => p.Acres * p.EstimatedYield);
        var totalContracted = Contracts
            .Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Pending)
            .Sum(c => c.Quantity);

        if (totalProjected > 0)
        {
            var marketShare = (double)totalContracted / totalProjected * 100;
            if (marketShare >= 70)
                items.Add($"Strong {marketShare:F0}% market share demonstrates excellent originator relationship.");
            else if (marketShare >= 40)
                items.Add($"Moderate {marketShare:F0}% market share indicates room for growth.");
            else
                items.Add($"Low {marketShare:F0}% market share presents significant opportunity.");
        }

        // Engagement analysis
        var daysSinceContact = GetDaysSinceLastContact();
        if (daysSinceContact > 90)
            items.Add($"No recent engagement in the past {daysSinceContact} days — relationship may be at risk.");
        else if (daysSinceContact > 30)
            items.Add($"Last engagement was {daysSinceContact} days ago — consider scheduling follow-up.");
        else
            items.Add("Recent engagement indicates healthy relationship status.");

        return items;
    }

    private List<string> GenerateActionItems()
    {
        var items = new List<string>();

        var daysSinceContact = GetDaysSinceLastContact();
        if (daysSinceContact > 30)
        {
            items.Add("PRIORITY: Schedule immediate contact to maintain relationship strength.");
        }

        // Revenue opportunity
        var totalProjected = PlantingIntentions.Sum(p => p.Acres * p.EstimatedYield);
        var totalContracted = Contracts
            .Where(c => c.Status == ContractStatus.Active || c.Status == ContractStatus.Pending)
            .Sum(c => c.Quantity);
        var uncontracted = totalProjected - totalContracted;

        if (uncontracted > 0)
        {
            var avgPrice = Contracts.Any() ? Contracts.Average(c => c.Price) : 5.00m;
            var revenueOpportunity = uncontracted * avgPrice;
            items.Add($"Revenue opportunity: {FormatCurrency(revenueOpportunity)} in uncontracted bushels at average pricing.");
        }

        // Contract renewals
        var expiringContracts = Contracts.Count(c => c.DeliveryEnd <= DateTime.Now.AddDays(30) && c.Status == ContractStatus.Active);
        if (expiringContracts > 0)
        {
            items.Add($"Review {expiringContracts} contract(s) expiring within 30 days for renewal discussions.");
        }

        if (!items.Any())
        {
            items.Add("Continue current engagement strategy — relationship is healthy.");
        }

        return items;
    }

    private string FormatCurrency(decimal amount)
    {
        if (amount >= 1000000)
            return $"${(amount / 1000000):F1}M";
        if (amount >= 1000)
            return $"${(amount / 1000):F0}K";
        return $"${amount:N0}";
    }
}
