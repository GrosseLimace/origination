@namespace GrainOriginatorPortal.Components.UI

<div class="@ComputedClass">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ComputedClass => $"flex flex-col gap-1.5 text-center sm:text-left {Class}".Trim();
}
