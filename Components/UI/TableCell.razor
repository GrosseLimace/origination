@namespace GrainOriginatorPortal.Components.UI

<td class="@ComputedClass" colspan="@(ColSpan > 1 ? ColSpan : null)">
    @ChildContent
</td>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public int ColSpan { get; set; } = 1;

    private string ComputedClass => $"p-2 align-middle whitespace-nowrap {Class}".Trim();
}
