@namespace GrainOriginatorPortal.Components.UI
@inject ToastService ToastService
@implements IDisposable

<div class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 w-full max-w-sm pointer-events-none">
    @foreach (var toast in ToastService.Toasts)
    {
        <div class="@GetContainerClass(toast.Variant) pointer-events-auto animate-slide-up" role="alert">
            <div class="flex items-start gap-3">
                <div class="@GetIconClass(toast.Variant)">
                    @switch (toast.Variant)
                    {
                        case ToastVariant.Success:
                            <Icon Name="check-circle" Size="20" />
                            break;
                        case ToastVariant.Error:
                            <Icon Name="x-circle" Size="20" />
                            break;
                        case ToastVariant.Warning:
                            <Icon Name="alert-triangle" Size="20" />
                            break;
                        default:
                            <Icon Name="info" Size="20" />
                            break;
                    }
                </div>
                <div class="flex-1 min-w-0">
                    @if (!string.IsNullOrEmpty(toast.Title))
                    {
                        <p class="font-medium text-gray-900 dark:text-white">@toast.Title</p>
                    }
                    <p class="text-sm text-gray-600 dark:text-gray-300">@toast.Message</p>
                </div>
                <button type="button"
                        class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                        @onclick="() => ToastService.Remove(toast.Id)">
                    <Icon Name="x" Size="16" />
                </button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += HandleChange;
    }

    private void HandleChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private string GetContainerClass(ToastVariant variant)
    {
        var baseClass = "bg-white dark:bg-gray-800 border rounded-lg shadow-lg p-4";
        var borderClass = variant switch
        {
            ToastVariant.Success => "border-green-200 dark:border-green-800",
            ToastVariant.Error => "border-red-200 dark:border-red-800",
            ToastVariant.Warning => "border-amber-200 dark:border-amber-800",
            _ => "border-blue-200 dark:border-blue-800"
        };
        return $"{baseClass} {borderClass}";
    }

    private string GetIconClass(ToastVariant variant) => variant switch
    {
        ToastVariant.Success => "text-green-500",
        ToastVariant.Error => "text-red-500",
        ToastVariant.Warning => "text-amber-500",
        _ => "text-blue-500"
    };

    public void Dispose()
    {
        ToastService.OnChange -= HandleChange;
    }
}
