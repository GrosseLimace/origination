@namespace GrainOriginatorPortal.Components.UI
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4" style="overflow: hidden;">
        <!-- Backdrop -->
        <div class="fixed inset-0 bg-black" style="opacity: 0.55;" @onclick="HandleBackdropClick"></div>

        <!-- Dialog Content -->
        <div class="@ContentClass" style="@SizeStyle" role="dialog" aria-modal="true">
            @if (ShowCloseButton)
            {
                <button type="button"
                        class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 border-0 bg-transparent p-0"
                        @onclick="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
                    </svg>
                </button>
            }
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow = 'hidden'");
        }
        else
        {
            await JS.InvokeVoidAsync("eval", "document.body.style.overflow = ''");
        }
    }

    private string ContentClass => $"relative z-50 max-h-[90vh] overflow-y-auto rounded-lg border bg-background p-6 shadow-lg {Class}".Trim();

    private string SizeStyle => Size switch
    {
        "xs" => "max-width: 256px; width: 100%;",
        "sm" => "max-width: 320px; width: 100%;",
        "md" => "max-width: 760px; width: 100%;",
        "default" => "max-width: 512px; width: 100%;",
        "lg" => "max-width: 672px; width: 100%;",
        "xl" => "max-width: 896px; width: 100%;",
        "full" => "max-width: 95vw; width: 100%;",
        _ => "max-width: 512px; width: 100%;"
    };

    private async Task HandleBackdropClick()
    {
        if (CloseOnBackdropClick)
        {
            await Close();
        }
    }

    public async Task Close()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    public async Task Open()
    {
        await IsOpenChanged.InvokeAsync(true);
    }
}
