@namespace GrainOriginatorPortal.Components.UI

<div class="@ContainerClass">
    <svg class="animate-spin @SizeClass text-green-600 dark:text-green-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
    </svg>
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">@Message</p>
    }
</div>

@code {
    [Parameter] public string Size { get; set; } = "default";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ContainerClass => $"flex flex-col items-center justify-center {Class}".Trim();

    private string SizeClass => Size switch
    {
        "sm" => "h-4 w-4",
        "default" => "h-8 w-8",
        "lg" => "h-12 w-12",
        "xl" => "h-16 w-16",
        _ => "h-8 w-8"
    };
}
