@namespace GrainOriginatorPortal.Components.UI
@implements IDisposable

<div class="relative">
    <svg xmlns="http://www.w3.org/2000/svg"
         width="16"
         height="16"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="absolute top-1/2 text-gray-400 pointer-events-none"
         style="left: 12px; transform: translateY(-50%);">
        <circle cx="11" cy="11" r="8"/>
        <path d="m21 21-4.3-4.3"/>
    </svg>
    <input type="text"
           class="w-full h-10 rounded-md border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-sm text-gray-900 dark:text-white placeholder:text-gray-400 dark:placeholder:text-gray-500 focus:outline-none focus:ring-2 focus:ring-green-500 focus:border-transparent"
           style="padding: 8px 40px 8px 36px;"
           placeholder="@Placeholder"
           value="@_currentValue"
           @oninput="HandleInput"
           @onkeydown="HandleKeyDown" />
    @if (!string.IsNullOrEmpty(_currentValue))
    {
        <button type="button"
                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200"
                @onclick="ClearSearch">
            <Icon Name="x" Size="16" />
        </button>
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Search...";
    [Parameter] public int DebounceMs { get; set; } = 300;
    [Parameter] public string? Class { get; set; }

    private System.Timers.Timer? _debounceTimer;
    private string _currentValue = "";

    protected override void OnParametersSet()
    {
        _currentValue = Value ?? "";
    }

    private void HandleInput(ChangeEventArgs e)
    {
        _currentValue = e.Value?.ToString() ?? "";

        _debounceTimer?.Stop();
        _debounceTimer?.Dispose();

        _debounceTimer = new System.Timers.Timer(DebounceMs);
        _debounceTimer.Elapsed += async (s, args) =>
        {
            _debounceTimer?.Stop();
            await InvokeAsync(async () =>
            {
                await ValueChanged.InvokeAsync(_currentValue);
            });
        };
        _debounceTimer.Start();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            _debounceTimer?.Stop();
            await ValueChanged.InvokeAsync(_currentValue);
        }
        else if (e.Key == "Escape")
        {
            await ClearSearch();
        }
    }

    private async Task ClearSearch()
    {
        _currentValue = "";
        await ValueChanged.InvokeAsync("");
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
