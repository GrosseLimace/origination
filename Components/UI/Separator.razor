@namespace GrainOriginatorPortal.Components.UI

@if (Orientation == "horizontal")
{
    <div class="@HorizontalClass" role="separator"></div>
}
else
{
    <div class="@VerticalClass" role="separator"></div>
}

@code {
    [Parameter] public string Orientation { get; set; } = "horizontal";
    [Parameter] public string? Class { get; set; }

    private string HorizontalClass => $"shrink-0 bg-border h-[1px] w-full {Class}".Trim();
    private string VerticalClass => $"shrink-0 bg-border w-[1px] h-full {Class}".Trim();
}
