@namespace GrainOriginatorPortal.Components.UI

<span class="@ComputedClass">
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string Variant { get; set; } = "default";
    [Parameter] public string? Class { get; set; }

    private string ComputedClass => $"{BaseClass} {VariantClass} {Class}".Trim();

    private string BaseClass => "inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold transition-colors";

    private string VariantClass => Variant switch
    {
        "default" => "bg-primary text-primary-foreground",
        "secondary" => "bg-secondary text-secondary-foreground",
        "destructive" => "bg-destructive text-destructive-foreground",
        "outline" => "border text-foreground",
        _ => "bg-primary text-primary-foreground"
    };
}
