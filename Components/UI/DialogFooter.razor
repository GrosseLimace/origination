@namespace GrainOriginatorPortal.Components.UI

<div class="@ComputedClass">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ComputedClass => $"flex flex-col-reverse sm:flex-row sm:justify-end gap-2 mt-4 {Class}".Trim();
}
