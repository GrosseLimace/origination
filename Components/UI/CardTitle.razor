@namespace GrainOriginatorPortal.Components.UI

<h3 class="@ComputedClass">
    @ChildContent
</h3>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ComputedClass => $"text-lg font-semibold leading-none tracking-tight {Class}".Trim();
}
