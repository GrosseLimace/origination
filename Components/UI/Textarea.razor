@namespace GrainOriginatorPortal.Components.UI

<textarea class="@ComputedClass"
          style="resize: none;"
          placeholder="@Placeholder"
          rows="@Rows"
          disabled="@Disabled"
          readonly="@ReadOnly"
          @oninput="HandleInput">@Value</textarea>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private string ComputedClass => $"flex min-h-[80px] w-full rounded-md border border-gray-300 dark:border-gray-500 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 px-3 py-2 text-sm transition-colors placeholder:text-gray-400 dark:placeholder:text-gray-400 focus:outline-none focus:ring-2 focus:ring-green-500 dark:focus:ring-green-400 disabled:cursor-not-allowed disabled:opacity-50 resize-none {Class}".Trim();

    private async Task HandleInput(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(value);
    }
}
