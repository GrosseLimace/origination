@namespace GrainOriginatorPortal.Components.UI

<p class="@ComputedClass">
    @ChildContent
</p>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }

    private string ComputedClass => $"text-sm text-muted-foreground {Class}".Trim();
}
