@page "/"
@namespace GrainOriginatorPortal.Components.Pages
@inject AppState AppState
@inject IDataService DataService
@inject ThemeService ThemeService
@inject ToastService ToastService
@using GrainOriginatorPortal.Components.Features.Insights
@using GrainOriginatorPortal.Components.Features.ListBuilder
@rendermode InteractiveServer

<PageTitle>Grain Originator Portal</PageTitle>

@if (AppState.CurrentView == "customers")
{
    <!-- Mobile: Back button when customer is selected -->
    @if (AppState.SelectedCustomer != null)
    {
        <Button Variant="ghost" OnClick="ClearSelection" Class="mb-4 lg:hidden">
            <Icon Name="arrow-left" Size="16" Class="mr-2" />
            Back to Customers
        </Button>
    }

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Customer List -->
        <div class="lg:col-span-1 @(AppState.SelectedCustomer != null ? "hidden lg:block" : "")">
            <CustomerList SelectedCustomer="@AppState.SelectedCustomer"
                          OnSelectCustomer="HandleSelectCustomer"
                          SavedLists="@savedLists" />
        </div>

        <!-- Customer Profile -->
        <div class="lg:col-span-2 @(AppState.SelectedCustomer == null ? "hidden lg:block" : "")">
            @if (AppState.SelectedCustomer != null)
            {
                <CustomerProfile Customer="@AppState.SelectedCustomer"
                                 Contracts="@customerContracts"
                                 Tickets="@customerTickets"
                                 PlantingIntentions="@customerPlantingIntentions"
                                 Notes="@customerNotes"
                                 StoredGrain="@customerStoredGrain"
                                 Farms="@customerFarms"
                                 AllFarms="@allFarms"
                                 SelectedFarmId="@AppState.SelectedFarmId"
                                 IsDarkMode="@isDarkMode"
                                 OnFarmChange="HandleFarmChange"
                                 OnAddNote="HandleAddNote"
                                 OnTogglePin="HandleTogglePin"
                                 OnSaveCustomer="HandleSaveCustomer"
                                 OnCreateFarm="HandleCreateFarm"
                                 OnAddPlantingIntention="HandleAddPlantingIntention"
                                 OnEditPlantingIntention="HandleEditPlantingIntention" />
            }
            else
            {
                <Card Class="p-12 text-center">
                    <Icon Name="wheat" Size="48" Class="mx-auto mb-4 text-gray-300 dark:text-gray-600" />
                    <h3 class="text-gray-500 dark:text-gray-400 mb-2">No Customer Selected</h3>
                    <p class="text-sm text-gray-400 dark:text-gray-500">Select a customer from the list to view their profile</p>
                </Card>
            }
        </div>
    </div>
}
else if (AppState.CurrentView == "insights")
{
    <ActionableInsights Customers="@allCustomers"
                        Contracts="@allContracts"
                        Tickets="@allTickets"
                        Notes="@allNotes"
                        PlantingIntentions="@allPlantingIntentions"
                        OnSelectCustomer="HandleSelectCustomerFromInsights" />
}
else if (AppState.CurrentView == "buildlist")
{
    <BuildList Customers="@allCustomers"
               Contracts="@allContracts"
               PlantingIntentions="@allPlantingIntentions"
               Notes="@allNotes"
               StoredGrain="@allStoredGrain"
               SavedLists="@savedLists"
               OnSelectCustomer="HandleSelectCustomerFromInsights"
               OnSaveList="HandleSaveList"
               OnDeleteList="HandleDeleteList" />
}
else if (AppState.CurrentView == "dashboard")
{
    <TerritoryDashboard Customers="@allCustomers"
                        Contracts="@allContracts"
                        PlantingIntentions="@allPlantingIntentions"
                        IsDarkMode="@isDarkMode" />
}

@code {
    // All data for insights
    private List<Customer> allCustomers = new();
    private List<Contract> allContracts = new();
    private List<Ticket> allTickets = new();
    private List<Note> allNotes = new();
    private List<PlantingIntention> allPlantingIntentions = new();
    private List<Farm> allFarms = new();
    private List<StoredGrain> allStoredGrain = new();

    private bool isDarkMode => ThemeService.IsDarkMode;

    // Customer-specific data
    private List<SavedList> savedLists = new();
    private List<Contract> customerContracts = new();
    private List<Ticket> customerTickets = new();
    private List<PlantingIntention> customerPlantingIntentions = new();
    private List<Note> customerNotes = new();
    private List<StoredGrain> customerStoredGrain = new();
    private List<Farm> customerFarms = new();

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += HandleStateChange;
        ThemeService.OnThemeChanged += HandleThemeChange;
        await ThemeService.InitializeAsync();
        LoadAllData();
        LoadCustomerData();
    }

    private void HandleThemeChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void LoadAllData()
    {
        allCustomers = DataService.GetCustomers();
        allContracts = DataService.GetContracts();
        allTickets = DataService.GetTickets();
        allNotes = DataService.GetNotes();
        allPlantingIntentions = DataService.GetPlantingIntentions();
        allFarms = DataService.GetFarms();
        allStoredGrain = DataService.GetStoredGrain();
        savedLists = DataService.GetSavedLists();
    }

    private void HandleStateChange()
    {
        LoadCustomerData();
        InvokeAsync(StateHasChanged);
    }

    private void LoadCustomerData()
    {
        if (AppState.SelectedCustomer != null)
        {
            var customerId = AppState.SelectedCustomer.Id;
            customerContracts = DataService.GetContractsByCustomer(customerId);
            customerTickets = DataService.GetTicketsByCustomer(customerId);
            customerPlantingIntentions = DataService.GetPlantingIntentionsByCustomer(customerId);
            customerNotes = DataService.GetNotesByCustomer(customerId);
            customerStoredGrain = DataService.GetStoredGrainByCustomer(customerId);
            customerFarms = DataService.GetFarmsByCustomer(customerId);
        }
    }

    private void HandleSelectCustomer(Customer customer)
    {
        AppState.SelectedCustomer = customer;
    }

    private void HandleSelectCustomerFromInsights(Customer customer)
    {
        AppState.SelectedCustomer = customer;
        AppState.CurrentView = "customers";
    }

    private void HandleFarmChange(string farmId)
    {
        AppState.SelectedFarmId = farmId;
    }

    private void HandleAddNote((string CustomerId, string? FarmId, string Content) noteData)
    {
        DataService.AddNote(noteData.CustomerId, noteData.FarmId, "Current User", noteData.Content);
        ToastService.Success("Note added successfully");
        RefreshData();
    }

    private void HandleTogglePin(string noteId)
    {
        DataService.ToggleNotePin(noteId);
        ToastService.Info("Note pin status updated");
        RefreshData();
    }

    private void HandleSaveCustomer((string CustomerId, string Location, string Phone, string Email, List<string> FarmIds) data)
    {
        DataService.UpdateCustomer(data.CustomerId, data.Location, data.Phone, data.Email, data.FarmIds);

        // Refresh the selected customer
        allCustomers = DataService.GetCustomers();
        AppState.SelectedCustomer = allCustomers.FirstOrDefault(c => c.Id == data.CustomerId);
        ToastService.Success("Customer updated successfully");
        RefreshData();
    }

    private void HandleCreateFarm((string Name, string Location, int Acres) data)
    {
        DataService.CreateFarm(data.Name, data.Location, data.Acres);
        allFarms = DataService.GetFarms();
        ToastService.Success($"Farm '{data.Name}' created successfully");
        StateHasChanged();
    }

    private void HandleAddPlantingIntention((string CustomerId, string? FarmId, string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield) data)
    {
        DataService.AddPlantingIntention(data.CustomerId, data.FarmId ?? "", data.Crop, data.Acres, data.Variety, data.PlantingDate, data.EstimatedYield);
        ToastService.Success($"Planting intention for {data.Crop} added");
        RefreshData();
    }

    private void HandleEditPlantingIntention((string IntentionId, string Crop, int Acres, string Variety, DateTime PlantingDate, int EstimatedYield) data)
    {
        DataService.UpdatePlantingIntention(data.IntentionId, data.Crop, data.Acres, data.Variety, data.PlantingDate, data.EstimatedYield);
        ToastService.Success("Planting intention updated");
        RefreshData();
    }

    private void HandleSaveList((string Name, string Query, List<string> CustomerIds) listData)
    {
        DataService.SaveList(listData.Name, listData.Query, listData.CustomerIds);
        savedLists = DataService.GetSavedLists();
        ToastService.Success($"List '{listData.Name}' saved with {listData.CustomerIds.Count} customers");
        StateHasChanged();
    }

    private void HandleDeleteList(string listId)
    {
        DataService.DeleteList(listId);
        savedLists = DataService.GetSavedLists();
        ToastService.Info("List deleted");
        StateHasChanged();
    }

    private void RefreshData()
    {
        allNotes = DataService.GetNotes();
        allPlantingIntentions = DataService.GetPlantingIntentions();
        allCustomers = DataService.GetCustomers();
        allFarms = DataService.GetFarms();
        LoadCustomerData();
        StateHasChanged();
    }

    private void ClearSelection()
    {
        AppState.ClearSelection();
    }

    public void Dispose()
    {
        AppState.OnChange -= HandleStateChange;
        ThemeService.OnThemeChanged -= HandleThemeChange;
    }
}
