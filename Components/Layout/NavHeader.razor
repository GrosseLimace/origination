@inject ThemeService ThemeService
@inject AppState AppState
@rendermode InteractiveServer

<header class="sticky top-0 z-50 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <Icon Name="wheat" Size="32" Class="text-green-600 dark:text-green-500" />
                <div>
                    <h1 class="text-gray-900 dark:text-white">Grain Originator Portal</h1>
                    <p class="text-sm text-gray-500 dark:text-gray-400 hidden sm:block">Customer & Contract Management</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <!-- Desktop navigation buttons -->
                <Button Variant="@(AppState.CurrentView == "dashboard" ? "default" : "outline")"
                        OnClick="@(() => HandleViewChange("dashboard"))"
                        Class="gap-2 hidden lg:inline-flex">
                    <Icon Name="@(AppState.CurrentView == "dashboard" ? "arrow-left" : "bar-chart-2")" Size="16" />
                    <span>@(AppState.CurrentView == "dashboard" ? "Back to Customers" : "Dashboard")</span>
                </Button>

                <Button Variant="@(AppState.CurrentView == "buildlist" ? "default" : "outline")"
                        OnClick="@(() => HandleViewChange("buildlist"))"
                        Class="gap-2 hidden lg:inline-flex">
                    <Icon Name="@(AppState.CurrentView == "buildlist" ? "arrow-left" : "list-filter")" Size="16" />
                    <span>@(AppState.CurrentView == "buildlist" ? "Back to Customers" : "Build a List")</span>
                </Button>

                <Button Variant="@(AppState.CurrentView == "insights" ? "default" : "outline")"
                        OnClick="@(() => HandleViewChange("insights"))"
                        Class="gap-2 hidden lg:inline-flex">
                    <Icon Name="@(AppState.CurrentView == "insights" ? "arrow-left" : "sparkles")" Size="16" />
                    <span>@(AppState.CurrentView == "insights" ? "Back to Customers" : "Actionable Insights")</span>
                </Button>

                <!-- Theme toggle - visible on all sizes -->
                <Button Variant="outline" OnClick="ToggleTheme" Size="icon" Class="hidden sm:inline-flex">
                    @if (ThemeService.IsDarkMode)
                    {
                        <Icon Name="moon" Size="16" />
                    }
                    else
                    {
                        <Icon Name="sun" Size="16" />
                    }
                </Button>
            </div>
        </div>
    </div>
</header>

@code {

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        AppState.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize theme from localStorage
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void HandleViewChange(string view)
    {
        if (AppState.CurrentView == view)
        {
            AppState.CurrentView = "customers";
        }
        else
        {
            AppState.CurrentView = view;
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        AppState.OnChange -= StateHasChanged;
    }
}
