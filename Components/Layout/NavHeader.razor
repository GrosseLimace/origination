@inject ThemeService ThemeService
@inject AppState AppState
@rendermode InteractiveServer

<header class="@HeaderClass">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
                <Icon Name="wheat" Size="32" Class="text-green-600 dark:text-green-500" />
                <div>
                    <h1 class="text-gray-900 dark:text-white">Grain Originator Portal</h1>
                    <p class="text-sm text-gray-500 dark:text-gray-400 hidden sm:block">Customer & Contract Management</p>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <Button Variant="@(AppState.CurrentView == "buildlist" ? "default" : "outline")"
                        OnClick="@(() => HandleViewChange("buildlist"))"
                        Class="gap-2 hidden md:inline-flex">
                    <Icon Name="list-filter" Size="16" />
                    <span class="hidden sm:inline">
                        @(AppState.CurrentView == "buildlist" ? "Back to Customers" : "Build a List")
                    </span>
                </Button>

                <Button Variant="@(AppState.CurrentView == "insights" ? "default" : "outline")"
                        OnClick="@(() => HandleViewChange("insights"))"
                        Class="gap-2 hidden md:inline-flex">
                    <Icon Name="sparkles" Size="16" />
                    <span class="hidden sm:inline">
                        @(AppState.CurrentView == "insights" ? "Back to Customers" : "Actionable Insights")
                    </span>
                </Button>

                <Button Variant="outline" OnClick="ToggleTheme" Class="gap-2">
                    @if (ThemeService.IsDarkMode)
                    {
                        <Icon Name="moon" Size="16" />
                    }
                    else
                    {
                        <Icon Name="sun" Size="16" />
                    }
                    <span class="hidden sm:inline">
                        @(ThemeService.IsDarkMode ? "Light Mode" : "Dark Mode")
                    </span>
                </Button>
            </div>
        </div>
    </div>
</header>

@code {
    private string HeaderClass => ThemeService.IsDarkMode
        ? "bg-gray-800 border-b border-gray-700"
        : "bg-white border-b border-gray-200";

    protected override void OnInitialized()
    {
        ThemeService.OnThemeChanged += HandleThemeChanged;
        AppState.OnChange += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Initialize theme from localStorage
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private void HandleThemeChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void HandleViewChange(string view)
    {
        if (AppState.CurrentView == view)
        {
            AppState.CurrentView = "customers";
        }
        else
        {
            AppState.CurrentView = view;
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        AppState.OnChange -= StateHasChanged;
    }
}
